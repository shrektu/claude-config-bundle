#!__HOME__/.pyenv/versions/3.14.3/bin/python3
"""Ask a fresh, read-only Claude session to review the change being committed.

The scope flags select the same changes lint-strict checks: the index
(--staged), the tracked working tree (--tracked, as ``commit -a``) or the
whole working tree with untracked files (default), optionally narrowed by
--paths. The reviewer reports architecture, simplification, duplication,
typing, naming and team-habit findings on the changed lines.
Exit 0 means pass or skipped, 1 findings, 2 the review could not run.
"""

import argparse
import contextlib
import datetime
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import asdict, dataclass
from enum import StrEnum
from pathlib import Path
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from collections.abc import Iterable, Mapping, Sequence

PROGRAM = "ai-review-gate"
PROMPT_VERSION = "2"
CHECK_COMMAND = "check"
WAIVE_COMMAND = "waive"
EXIT_PASS = 0
EXIT_FINDINGS = 1
EXIT_ERROR = 2

RECURSION_ENV = "CLAUDE_AI_REVIEW_GATE"
RECURSION_ON = "1"
CACHE_DIR_ENV = "AI_REVIEW_CACHE_DIR"
DEFAULT_CACHE_DIR = "~/.cache/claude-ai-review"
WAIVERS_FILE = "waivers.json"
ROUNDS_DIR = "rounds"
MAX_ROUNDS = 5
MAX_REMEMBERED_FINDINGS = 60
VERDICT_SUFFIX = ".json"
MODEL_ENV = "AI_REVIEW_MODEL"
DEFAULT_MODEL = "sonnet"
EFFORT_ENV = "AI_REVIEW_EFFORT"
DEFAULT_EFFORT = "high"
TIMEOUT_ENV = "AI_REVIEW_TIMEOUT"
DEFAULT_TIMEOUT = 600.0
ATTEMPTS_ENV = "AI_REVIEW_ATTEMPTS"
MAX_ENGINE_ATTEMPTS = 3
ENGINE_CMD_ENV = "AI_REVIEW_ENGINE_CMD"
HABITS_BIN_ENV = "AI_REVIEW_HABITS_BIN"
DEFAULT_HABITS_BIN = "~/.claude/bin/habits"
HABITS_MAX_CHARS = "20000"
HABITS_TIMEOUT = 30.0

CLAUDE_BIN = "claude"
REVIEWER_TOOLS = ("Read", "Grep", "Glob")
FORBIDDEN_TOOLS = (
    "Bash",
    "Edit",
    "Write",
    "NotebookEdit",
    "WebFetch",
    "WebSearch",
    "Agent",
)

GIT = "git"
INDEX_FILE_ENV = "GIT_INDEX_FILE"
TEMP_INDEX_NAME = "index"
HEAD = "HEAD"
EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
MERGE_HEAD = "MERGE_HEAD"
PATHSPEC_SEPARATOR = "--"
DIFF_FLAGS = ("--no-color", "--no-ext-diff", "--no-textconv", "-M")
CONTEXT_FLAG = "-U10"
DELTA_CONTEXT_FLAG = "-U0"
DETACHED_BRANCH = "HEAD"
TREE_PATTERN = re.compile(r"[0-9a-f]{40,64}")
ELAPSED_DIGITS = 1
GIT_OK = frozenset({0})
NO_INDEX_EXIT_CODES = frozenset({0, 1})
NUL = "\0"
NEWLINE = "\n"
ENCODING = "utf-8"
DECODE_ERRORS = "replace"
JSON_OPEN = "{"

FINDING_ID_LENGTH = 10

SKIP_RECURSION = "recursion guard"
SKIP_MERGE = "merge commit"
SKIP_EMPTY = "empty diff"
PASS_LINE = f"{PROGRAM}: pass"
WAIVE_HINT = (
    f"{PROGRAM}: fix each finding, or waive one with: {PROGRAM} waive"
    ' --repo {repo} --finding <id> --reason "..."'
)

REVIEW_INSTRUCTIONS = """\
You review a change about to be committed in this repository. You may read
any file of the repository to compare the change with the existing code.

Report ONLY these problems, and only on lines the diff adds or changes:
- architecture: structure inconsistent with how the repository already does
  it (layers, patterns, conventions, file or module layout, a new
  abstraction parallel to an existing one, dependencies pointing the wrong
  way);
- duplication: a new helper duplicating one that already exists;
- habit: a broken team habit from the list below;
- test-quality: a weak test, in the test files of the diff. Report a mirror
  assertion (the expected value is computed by the code under test or a copy
  of its logic instead of a literal written by hand); a change detector (a
  test that only pins a constant or configuration value instead of the
  behaviour depending on it); a partial mock (a fake, mock or fixture whose
  data shape is incomplete compared with the real structure, or one shared
  fake standing in for branches that need their own); a mock-only assertion
  (asserting that a mock was called or returned what it was told, with no
  assertion on the behaviour of the code under test); a mock or fixture that
  replaces the very thing the test claims to check; production code
  (methods, flags, branches) that exists only for tests; a fixed sleep or
  delay where a condition-based wait with a timeout is possible.

Rules for the review history, when the prompt carries it:
- never re-raise a waived finding, nor one an earlier round already raised
  and the current diff fixed;
- never ask to undo or contradict a change an earlier round requested;
- when the prompt has a "Changed since the last round" section, report only
  problems on lines in that section, plus earlier findings that are still
  unfixed in the current diff; the full diff is context.

Types, magic values, naming, formatting and simplification are covered by
static analysis and the orchestrator: never report them.

Do not report style, formatting or lint-rule remarks, and do not praise.
Each finding names the exact path, the line number on the new side of the
diff, one category from: architecture, duplication, habit, test-quality, and
one or two sentences naming the concrete change to make.

Reply with a single JSON object and nothing else:
{"findings": [{"path": "...", "line": 1, "category": "...", "text": "..."}]}
Reply {"findings": []} when there is nothing to report.
"""
FILES_HEADING = "Changed files:"
HABITS_HEADING = "Team habits:"
EARLIER_HEADING = "Earlier rounds on this branch:"
WAIVED_HEADING = "Waived in this repository, never raise again:"
DELTA_HEADING = "Changed since the last round:"
NO_CHANGES = "(no changes)"
CLEAN_ROUND = "no findings"
DIFF_HEADING = "Diff:"
DIFF_FENCE_OPEN = "```diff"
DIFF_FENCE_CLOSE = "```"


class Mode(StrEnum):
    """Which changes are reviewed, as in lint-strict."""

    WORKTREE = "working tree vs HEAD"
    STAGED = "staged (index vs HEAD)"
    TRACKED = "tracked working tree vs HEAD"


class Category(StrEnum):
    """The kinds of finding the reviewer may report."""

    ARCHITECTURE = "architecture"
    DUPLICATION = "duplication"
    HABIT = "habit"
    TEST_QUALITY = "test-quality"


class Key(StrEnum):
    """The JSON keys of verdicts, envelopes, waivers and reports."""

    FINDINGS = "findings"
    RESULT = "result"
    IS_ERROR = "is_error"
    PATH = "path"
    LINE = "line"
    CATEGORY = "category"
    TEXT = "text"
    ID = "id"
    REASON = "reason"
    TIMESTAMP = "timestamp"
    TREE = "tree"
    BASE = "base"
    COMPLETE = "complete"
    REVIEWER = "reviewer"
    ROUNDS = "rounds"
    ELAPSED_SECONDS = "elapsed_seconds"
    STATUS = "status"
    WAIVED = "waived"


CATEGORY_VALUES = frozenset(Category)


class Origin(StrEnum):
    """Where a verdict came from; the value is its report label."""

    REVIEWED = "reviewed"
    CACHED = "cached"
    UNCHANGED = "unchanged since the last review"


class Status(StrEnum):
    """The verdict of one check."""

    PASSED = "passed"
    FINDINGS = "findings"
    SKIPPED = "skipped"


class GateError(Exception):
    """The review could not run; the message says why."""


class VerdictError(GateError):
    """The reviewer answered without a parseable, schema-valid verdict."""


UNREADABLE_MEMORY = (OSError, ValueError, TypeError, GateError)


@dataclass(frozen=True, slots=True)
class Scope:
    """The mode and the repo-root pathspecs of a check."""

    mode: Mode
    paths: tuple[str, ...]


@dataclass(frozen=True, slots=True)
class Change:
    """The diff under review and the files it touches."""

    diff: str
    files: tuple[str, ...]


@dataclass(frozen=True, slots=True)
class Finding:
    """One problem the reviewer reported on a changed line."""

    path: str
    line: int
    category: Category
    text: str

    @property
    def id(self) -> str:
        """Return the id that stays stable when the finding moves lines."""
        raw = f"{self.path}{self.category}{self.text}"
        digest = hashlib.sha1(raw.encode(ENCODING), usedforsecurity=False)
        return digest.hexdigest()[:FINDING_ID_LENGTH]

    def describe(self) -> str:
        """Return the one-line report of the finding."""
        return (
            f"{self.path}:{self.line} [{self.category}] {self.text}"
            f" (id {self.id})"
        )


@dataclass(frozen=True, slots=True)
class Verdict:
    """The reviewer's findings and how long obtaining them took."""

    findings: tuple[Finding, ...]
    elapsed_seconds: float
    origin: Origin = Origin.REVIEWED


@dataclass(frozen=True, slots=True)
class Waiver:
    """A recorded decision to accept one finding in one repository."""

    reason: str
    timestamp: str


@dataclass(frozen=True, slots=True)
class Report:
    """The outcome of a check, ready to print."""

    status: Status
    reason: str = ""
    findings: tuple[Finding, ...] = ()
    waived: tuple[tuple[Finding, Waiver], ...] = ()
    elapsed_seconds: float = 0.0
    origin: Origin = Origin.REVIEWED


@dataclass(frozen=True, slots=True)
class Memory:
    """The last reviewed tree and the findings of the last rounds."""

    tree: str | None
    rounds: tuple[tuple[Finding, ...], ...]
    base: str | None = None
    complete: bool = False
    reviewer: str | None = None

    def record(
        self,
        findings: tuple[Finding, ...],
        tree: str | None,
        base: str | None,
        *,
        complete: bool,
        reviewer: str,
    ) -> Memory:
        """Return the memory after one more completed round, capped."""
        repeated = bool(self.rounds) and self.rounds[-1] == findings
        rounds = self.rounds if repeated else (*self.rounds, findings)
        kept = newest_findings(rounds[-MAX_ROUNDS:])
        if tree is None:
            return Memory(self.tree, kept, self.base, reviewer=reviewer)
        return Memory(tree, kept, base, complete=complete, reviewer=reviewer)


@dataclass(frozen=True, slots=True)
class History:
    """What the prompt tells the reviewer about earlier rounds."""

    rounds: tuple[tuple[Finding, ...], ...]
    waivers: dict[str, Waiver]
    delta: str | None


@dataclass(frozen=True, slots=True)
class CheckOptions:
    """The parsed arguments of ``check``."""

    repo: Path
    mode: Mode
    paths: tuple[str, ...]
    json: bool


def decode(data: bytes) -> str:
    """Decode bytes as UTF-8, replacing undecodable bytes."""
    return data.decode(ENCODING, errors=DECODE_ERRORS)


def run_git(
    root: Path,
    *args: str,
    accepted: frozenset[int] = GIT_OK,
    env: Mapping[str, str] | None = None,
) -> str:
    """Run git in ``root`` and return its stdout.

    Raise GateError with git's stderr when the exit code is not accepted.
    """
    done = subprocess.run(
        [GIT, *args], cwd=root, capture_output=True, check=False, env=env
    )
    if done.returncode not in accepted:
        message = decode(done.stderr).strip() or f"git {args[0]} failed"
        raise GateError(message)
    return decode(done.stdout)


def repo_root(path: Path) -> Path:
    """Return the resolved work tree root containing ``path``."""
    if not path.is_dir():
        message = f"not a directory: {path}"
        raise GateError(message)
    root = run_git(path, "rev-parse", "--show-toplevel").strip()
    return Path(root).resolve()


def rebase_paths(
    root: Path, origin: Path, paths: Sequence[str]
) -> tuple[str, ...]:
    """Turn pathspecs relative to ``origin`` into repo-root pathspecs.

    Absolute paths are kept; a relative path escaping the repository
    raises GateError.
    """
    base = origin.resolve()
    rebased: list[str] = []
    for path in paths:
        if Path(path).is_absolute():
            rebased.append(path)
            continue
        candidate = Path(os.path.normpath(base / path))
        if not candidate.is_relative_to(root):
            message = f"path outside the repository: {path}"
            raise GateError(message)
        rebased.append(candidate.relative_to(root).as_posix())
    return tuple(rebased)


def base_tree(root: Path) -> str:
    """Return the tree of HEAD, or the empty tree without commits."""
    try:
        return run_git(
            root, "rev-parse", "--verify", "--quiet", f"{HEAD}^{{tree}}"
        ).strip()
    except GateError:
        return EMPTY_TREE


def diff_arguments(root: Path, mode: Mode) -> tuple[str, ...]:
    """Return the git diff arguments selecting the changes of ``mode``."""
    if mode is Mode.STAGED:
        return ("--cached", base_tree(root))
    return (base_tree(root),)


def untracked_files(root: Path, paths: tuple[str, ...]) -> list[str]:
    """Return the untracked, non-ignored regular files within ``paths``."""
    output = run_git(
        root,
        "ls-files",
        "-z",
        "--others",
        "--exclude-standard",
        PATHSPEC_SEPARATOR,
        *paths,
    )
    return [
        name
        for name in output.split(NUL)
        if name and (root / name).is_file() and not (root / name).is_symlink()
    ]


def new_file_diff(root: Path, name: str) -> str:
    """Return the diff adding the untracked file ``name``."""
    return run_git(
        root,
        "diff",
        "--no-index",
        CONTEXT_FLAG,
        *DIFF_FLAGS,
        PATHSPEC_SEPARATOR,
        os.devnull,
        name,
        accepted=NO_INDEX_EXIT_CODES,
    )


def collect_change(root: Path, scope: Scope) -> Change:
    """Return the diff and the changed files the scope selects."""
    arguments = diff_arguments(root, scope.mode)
    diff = run_git(
        root,
        "diff",
        *arguments,
        CONTEXT_FLAG,
        *DIFF_FLAGS,
        PATHSPEC_SEPARATOR,
        *scope.paths,
    )
    listing = run_git(
        root,
        "diff",
        *arguments,
        "--name-only",
        "-z",
        *DIFF_FLAGS,
        PATHSPEC_SEPARATOR,
        *scope.paths,
    )
    files = [name for name in listing.split(NUL) if name]
    if scope.mode is Mode.WORKTREE:
        untracked = untracked_files(root, scope.paths)
        diff += "".join(new_file_diff(root, name) for name in untracked)
        files.extend(untracked)
    return Change(diff, tuple(sorted(files)))


def is_merge(root: Path) -> bool:
    """Return whether a merge is in progress in the repository."""
    merge_head = run_git(root, "rev-parse", "--git-path", MERGE_HEAD).strip()
    return (root / merge_head).exists()


def habits_text(root: Path) -> str:
    """Return the team habits for the repository, or nothing."""
    binary = Path(
        os.environ.get(HABITS_BIN_ENV, DEFAULT_HABITS_BIN)
    ).expanduser()
    if not binary.is_file():
        return ""
    try:
        done = subprocess.run(
            [
                str(binary),
                "list",
                "--repo",
                str(root),
                "--max-chars",
                HABITS_MAX_CHARS,
            ],
            capture_output=True,
            timeout=HABITS_TIMEOUT,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return decode(done.stdout).strip() if done.returncode == EXIT_PASS else ""


def newest_findings(
    rounds: tuple[tuple[Finding, ...], ...],
) -> tuple[tuple[Finding, ...], ...]:
    """Return ``rounds`` trimmed to the newest remembered findings."""
    kept: list[tuple[Finding, ...]] = []
    budget = MAX_REMEMBERED_FINDINGS
    for found in reversed(rounds):
        if budget <= 0:
            break
        part = found[-budget:]
        kept.append(part)
        budget -= len(part)
    return tuple(reversed(kept))


def earlier_rounds_section(history: History) -> str | None:
    """Return the earlier findings and waivers, or None when empty."""
    if not any(history.rounds) and not history.waivers:
        return None
    lines = [EARLIER_HEADING]
    for number, found in enumerate(history.rounds, start=1):
        lines.append(f"Round {number}:" + ("" if found else f" {CLEAN_ROUND}"))
        lines.extend(f"- {finding.describe()}" for finding in found)
    if history.waivers:
        lines.append(WAIVED_HEADING)
        lines.extend(
            f"- {ident}: {' '.join(waiver.reason.split())}"
            for ident, waiver in history.waivers.items()
        )
    return NEWLINE.join(lines)


def fenced_diff(heading: str, diff: str) -> str:
    """Return ``diff`` in a fenced block under ``heading``."""
    return NEWLINE.join([heading, DIFF_FENCE_OPEN, diff, DIFF_FENCE_CLOSE])


def history_sections(history: History | None) -> list[str]:
    """Return the prompt sections the review history adds."""
    if history is None:
        return []
    sections = [earlier_rounds_section(history)]
    if history.delta is not None:
        sections.append(
            fenced_diff(DELTA_HEADING, history.delta.strip() or NO_CHANGES)
        )
    return [section for section in sections if section]


def build_prompt(
    change: Change, habits: str, history: History | None = None
) -> str:
    """Return the review prompt for a change, habits and history."""
    sections = [
        REVIEW_INSTRUCTIONS,
        NEWLINE.join([FILES_HEADING, *(f"- {name}" for name in change.files)]),
    ]
    if habits:
        sections.append(f"{HABITS_HEADING}{NEWLINE}{habits}")
    sections.extend(history_sections(history))
    sections.append(fenced_diff(DIFF_HEADING, change.diff))
    return (NEWLINE * 2).join(sections)


def engine_command() -> list[str]:
    """Return the reviewer command: the override, else ``claude -p``."""
    override = os.environ.get(ENGINE_CMD_ENV)
    if override:
        return shlex.split(override)
    return [
        CLAUDE_BIN,
        "-p",
        "--output-format",
        "json",
        "--model",
        os.environ.get(MODEL_ENV, DEFAULT_MODEL),
        "--effort",
        os.environ.get(EFFORT_ENV, DEFAULT_EFFORT),
        "--allowedTools",
        *REVIEWER_TOOLS,
        "--disallowedTools",
        *FORBIDDEN_TOOLS,
    ]


def engine_timeout() -> float:
    """Return the reviewer timeout in seconds, overridable through env."""
    try:
        return float(os.environ.get(TIMEOUT_ENV, DEFAULT_TIMEOUT))
    except ValueError:
        return DEFAULT_TIMEOUT


def engine_attempts() -> int:
    """Return how often the reviewer is asked for a valid verdict."""
    try:
        attempts = int(os.environ.get(ATTEMPTS_ENV, MAX_ENGINE_ATTEMPTS))
    except ValueError:
        return MAX_ENGINE_ATTEMPTS
    return max(attempts, 1)


def cache_dir() -> Path:
    """Return the directory holding cached verdicts and waivers."""
    return Path(os.environ.get(CACHE_DIR_ENV, DEFAULT_CACHE_DIR)).expanduser()


def cache_path(prompt: str, command: Sequence[str]) -> Path:
    """Return the verdict cache file for a prompt sent to a command."""
    identity = f"{prompt}{PROMPT_VERSION}{shlex.join(command)}"
    key = hashlib.sha256(identity.encode(ENCODING)).hexdigest()
    return cache_dir() / f"{key}{VERDICT_SUFFIX}"


def envelope_result(stdout: str) -> str:
    """Return the ``result`` text of a reviewer envelope, else empty."""
    try:
        document = json.loads(stdout)
    except ValueError:
        return ""
    if not isinstance(document, dict):
        return ""
    result = document.get(Key.RESULT)
    return result.strip() if isinstance(result, str) else ""


def run_engine(command: Sequence[str], prompt: str, root: Path) -> str:
    """Run the reviewer with ``prompt`` on stdin and return its stdout.

    Raise GateError when it is missing, fails or times out.
    """
    timeout = engine_timeout()
    try:
        done = subprocess.run(
            command,
            input=prompt.encode(ENCODING),
            capture_output=True,
            cwd=root,
            env={**os.environ, RECURSION_ENV: RECURSION_ON},
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        message = f"reviewer timed out after {timeout}s"
        raise GateError(message) from error
    except OSError as error:
        message = f"reviewer not runnable: {error}"
        raise GateError(message) from error
    if done.returncode != EXIT_PASS:
        stderr = decode(done.stderr).strip()
        detail = " ".join(
            filter(None, (stderr, envelope_result(decode(done.stdout)))),
        )
        message = f"reviewer exit {done.returncode}: {detail}".rstrip(": ")
        raise GateError(message)
    return decode(done.stdout)


def extract_verdict_object(text: str) -> dict[str, object] | None:
    """Return the outermost JSON object in ``text`` carrying findings."""
    decoder = json.JSONDecoder()
    start = text.find(JSON_OPEN)
    while start != -1:
        try:
            document, _ = decoder.raw_decode(text, start)
        except ValueError:
            document = None
        if isinstance(document, dict) and Key.FINDINGS in document:
            return document
        start = text.find(JSON_OPEN, start + 1)
    return None


def finding_from(item: object) -> Finding | None:
    """Validate one raw finding; None when its category is out of scope."""
    match item:
        case {
            Key.PATH: str(path),
            Key.LINE: int(line),
            Key.CATEGORY: str(category),
            Key.TEXT: str(text),
        } if (
            path
            and not isinstance(line, bool)
            and line > 0
            and text.strip()
        ):
            if category not in CATEGORY_VALUES:
                return None
            return Finding(path, line, Category(category), text)
    message = f"malformed finding: {item!r}"
    raise VerdictError(message)


def kept_findings(items: Iterable[object]) -> tuple[Finding, ...]:
    """Validate raw findings and drop the out-of-scope ones."""
    parsed = (finding_from(item) for item in items)
    return tuple(finding for finding in parsed if finding is not None)


def findings_from(document: dict[str, object]) -> tuple[Finding, ...]:
    """Validate a verdict object; raise VerdictError when it is malformed."""
    items = document.get(Key.FINDINGS)
    if not isinstance(items, list):
        message = "verdict findings is not a list"
        raise VerdictError(message)
    return kept_findings(items)


def verdict_text(stdout: str) -> str:
    """Return the reviewer's answer: the envelope ``result`` or stdout."""
    try:
        document = json.loads(stdout)
    except ValueError:
        return stdout
    if not isinstance(document, dict) or Key.RESULT not in document:
        return stdout
    result = document[Key.RESULT]
    if document.get(Key.IS_ERROR) or not isinstance(result, str):
        message = f"reviewer reported an error: {result!r}"
        raise GateError(message)
    return result


def parse_verdict(stdout: str) -> tuple[Finding, ...]:
    """Return the findings in reviewer output.

    Raise VerdictError when it carries no valid verdict, GateError when
    the reviewer reported an error.
    """
    document = extract_verdict_object(verdict_text(stdout))
    if document is None:
        message = "reviewer output carries no verdict JSON"
        raise VerdictError(message)
    return findings_from(document)


def elapsed_from(document: dict[str, object]) -> float:
    """Return the stored review time of a verdict document, or zero."""
    elapsed = document.get(Key.ELAPSED_SECONDS)
    return float(elapsed) if isinstance(elapsed, int | float) else 0.0


def cached_verdict(path: Path) -> Verdict | None:
    """Return a cached verdict, or None when absent or unreadable."""
    try:
        document = json.loads(path.read_text(encoding=ENCODING))
        if not isinstance(document, dict):
            return None
        findings = findings_from(document)
    except (OSError, ValueError, GateError):
        return None
    return Verdict(findings, elapsed_from(document), Origin.CACHED)


def findings_document(
    findings: Sequence[Finding],
) -> list[dict[str, object]]:
    """Return the JSON list form of ``findings``."""
    return [{Key.ID: finding.id, **asdict(finding)} for finding in findings]


def verdict_document(verdict: Verdict) -> dict[str, object]:
    """Return the verdict JSON object for ``verdict``."""
    return {
        Key.FINDINGS: findings_document(verdict.findings),
        Key.ELAPSED_SECONDS: round(verdict.elapsed_seconds, ELAPSED_DIGITS),
    }


def store_verdict(path: Path, verdict: Verdict) -> None:
    """Write a verdict to the cache; an unwritable cache is skipped."""
    document = json.dumps(verdict_document(verdict), ensure_ascii=False)
    with contextlib.suppress(OSError):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(document, encoding=ENCODING)


def ask_reviewer(
    command: Sequence[str], prompt: str, root: Path
) -> tuple[Finding, ...]:
    """Return the reviewer's verdict, asking again while it has none.

    Only an answer without a valid verdict is retried; a reviewer that
    fails, is missing or times out raises GateError at once.
    """
    attempts = engine_attempts()
    for _ in range(attempts - 1):
        with contextlib.suppress(VerdictError):
            return parse_verdict(run_engine(command, prompt, root))
    try:
        return parse_verdict(run_engine(command, prompt, root))
    except VerdictError as error:
        message = f"{error} after {attempts} attempts"
        raise GateError(message) from error


def branch_name(root: Path) -> str | None:
    """Return the current branch, or None on a detached HEAD."""
    try:
        name = run_git(root, "rev-parse", "--abbrev-ref", HEAD).strip()
    except GateError:
        return None
    return None if name == DETACHED_BRANCH else name


def memory_path(root: Path, branch: str) -> Path:
    """Return the round memory file of a branch in a repository."""
    identity = f"{root}{NUL}{branch}"
    key = hashlib.sha256(identity.encode(ENCODING)).hexdigest()
    return cache_dir() / ROUNDS_DIR / f"{key}{VERDICT_SUFFIX}"


def memory_file(root: Path) -> Path | None:
    """Return the round memory file of the current branch, if any."""
    branch = branch_name(root)
    return None if branch is None else memory_path(root, branch)


def known_tree(value: object) -> str | None:
    """Return ``value`` when it is a tree id, else None."""
    if isinstance(value, str) and TREE_PATTERN.fullmatch(value):
        return value
    return None


def known_reviewer(value: object) -> str | None:
    """Return ``value`` when it is a reviewer fingerprint, else None."""
    return value if isinstance(value, str) and value else None


def reviewer_fingerprint() -> str:
    """Return a hash of the instructions and the engine command."""
    identity = f"{REVIEW_INSTRUCTIONS}{shlex.join(engine_command())}"
    return hashlib.sha256(identity.encode(ENCODING)).hexdigest()


def load_memory(path: Path) -> Memory | None:
    """Return the stored round memory, or None when absent or corrupt."""
    try:
        match json.loads(path.read_text(encoding=ENCODING)):
            case {
                Key.TREE: str() | None as tree,
                Key.ROUNDS: list(rounds),
            } as document if tree is None or TREE_PATTERN.fullmatch(tree):
                return Memory(
                    tree,
                    tuple(kept_findings(found) for found in rounds),
                    known_tree(document.get(Key.BASE)),
                    document.get(Key.COMPLETE) is True,
                    known_reviewer(document.get(Key.REVIEWER)),
                )
    except UNREADABLE_MEMORY:
        return None
    return None


def save_memory(path: Path, memory: Memory) -> None:
    """Write the round memory; an unwritable cache is skipped."""
    document = json.dumps(
        {
            Key.TREE: memory.tree,
            Key.BASE: memory.base,
            Key.COMPLETE: memory.complete,
            Key.REVIEWER: memory.reviewer,
            Key.ROUNDS: [findings_document(found) for found in memory.rounds],
        },
        ensure_ascii=False,
    )
    with contextlib.suppress(OSError):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(document, encoding=ENCODING)


def real_index_path(root: Path) -> Path:
    """Return the path of the repository's real index file."""
    return root / run_git(root, "rev-parse", "--git-path", "index").strip()


def seed_index(root: Path, index: Path, env: Mapping[str, str]) -> None:
    """Fill the temporary ``index`` from the real index, else from HEAD."""
    with contextlib.suppress(OSError):
        shutil.copyfile(real_index_path(root), index)
        return
    run_git(root, "read-tree", base_tree(root), env=env)


def worktree_tree(root: Path) -> str:
    """Return the tree of the working tree, untracked files included."""
    with tempfile.TemporaryDirectory() as directory:
        index = Path(directory) / TEMP_INDEX_NAME
        env = {**os.environ, INDEX_FILE_ENV: str(index)}
        seed_index(root, index, env)
        run_git(root, "add", "-A", env=env)
        return run_git(root, "write-tree", env=env).strip()


def reviewed_tree(root: Path, scope: Scope) -> str | None:
    """Return the tree of the reviewed state, or None for a paths scope."""
    if scope.paths:
        return None
    try:
        if scope.mode is Mode.STAGED:
            return run_git(root, "write-tree").strip()
        return worktree_tree(root)
    except GateError:
        return None


def delta_since(
    root: Path, memory: Memory, tree: str | None, paths: tuple[str, ...]
) -> str | None:
    """Return the diff from the last reviewed tree, or None when unknown."""
    if memory.tree is None or tree is None:
        return None
    try:
        return run_git(
            root,
            "diff",
            memory.tree,
            tree,
            DELTA_CONTEXT_FLAG,
            *DIFF_FLAGS,
            PATHSPEC_SEPARATOR,
            *paths,
        )
    except GateError:
        return None


def build_history(
    root: Path, scope: Scope, memory: Memory, tree: str | None
) -> History:
    """Return what earlier rounds tell the reviewer about this one."""
    waivers = load_waivers().get(str(root), {})
    delta = delta_since(root, memory, tree, scope.paths)
    return History(memory.rounds, waivers, delta)


def timed_verdict(command: Sequence[str], prompt: str, root: Path) -> Verdict:
    """Ask the reviewer and return its verdict with the time it took."""
    started = time.monotonic()
    findings = ask_reviewer(command, prompt, root)
    return Verdict(findings, time.monotonic() - started)


def fresh_verdict(
    root: Path,
    scope: Scope,
    change: Change,
    memory: Memory | None,
    tree: str | None,
) -> Verdict:
    """Return the cached verdict for ``change``, else ask the reviewer."""
    command = engine_command()
    habits = habits_text(root)
    path = cache_path(build_prompt(change, habits), command)
    verdict = cached_verdict(path)
    if verdict is not None:
        return verdict
    history = (
        None if memory is None else build_history(root, scope, memory, tree)
    )
    prompt = build_prompt(change, habits, history)
    verdict = timed_verdict(command, prompt, root)
    store_verdict(path, verdict)
    return verdict


def covers_whole_state(root: Path, scope: Scope) -> bool:
    """Return whether the scope's diff shows every change in its tree."""
    if scope.paths:
        return False
    return scope.mode is not Mode.TRACKED or not untracked_files(root, ())


def remembered_findings(
    memory: Memory | None, tree: str | None, base: str, *, whole: bool
) -> tuple[Finding, ...] | None:
    """Return the last round's findings if this state was reviewed."""
    if memory is None or tree is None or not memory.rounds or not whole:
        return None
    if not memory.complete or (tree, base) != (memory.tree, memory.base):
        return None
    last = memory.rounds[-1]
    return None if len(last) >= MAX_REMEMBERED_FINDINGS else last


def review(root: Path, scope: Scope, change: Change) -> Verdict:
    """Return the verdict for ``change`` and record the round."""
    memory_at = memory_file(root)
    reviewer = reviewer_fingerprint()
    memory = None if memory_at is None else load_memory(memory_at)
    if memory is not None and memory.reviewer != reviewer:
        memory = None
    tree = reviewed_tree(root, scope)
    base = base_tree(root)
    whole = covers_whole_state(root, scope)
    remembered = remembered_findings(memory, tree, base, whole=whole)
    if remembered is None:
        verdict = fresh_verdict(root, scope, change, memory, tree)
    else:
        verdict = Verdict(remembered, 0.0, Origin.UNCHANGED)
    if memory_at is not None:
        complete = tree is not None and whole
        earlier = memory or Memory(None, ())
        recorded = earlier.record(
            verdict.findings,
            tree,
            base,
            complete=complete,
            reviewer=reviewer,
        )
        save_memory(memory_at, recorded)
    return verdict


def waivers_path() -> Path:
    """Return the file holding every recorded waiver."""
    return cache_dir() / WAIVERS_FILE


def load_waivers() -> dict[str, dict[str, Waiver]]:
    """Return the waivers keyed by repo root and then finding id."""
    path = waivers_path()
    if not path.exists():
        return {}
    try:
        raw = json.loads(path.read_text(encoding=ENCODING))
        return {
            root: {
                ident: Waiver(entry[Key.REASON], entry[Key.TIMESTAMP])
                for ident, entry in entries.items()
            }
            for root, entries in raw.items()
        }
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
        message = f"unreadable waivers file {path}: {error}"
        raise GateError(message) from error


def save_waivers(waivers: dict[str, dict[str, Waiver]]) -> None:
    """Write every waiver to the waivers file."""
    path = waivers_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    raw = {
        root: {ident: asdict(waiver) for ident, waiver in entries.items()}
        for root, entries in waivers.items()
    }
    path.write_text(
        json.dumps(raw, ensure_ascii=False, indent=2), encoding=ENCODING
    )


def apply_waivers(root: Path, verdict: Verdict) -> Report:
    """Split findings into blocking and waived ones for ``root``."""
    waivers = load_waivers().get(str(root), {})
    found = verdict.findings
    blocking = tuple(f for f in found if f.id not in waivers)
    waived = tuple((f, waivers[f.id]) for f in found if f.id in waivers)
    status = Status.FINDINGS if blocking else Status.PASSED
    return Report(
        status,
        findings=blocking,
        waived=waived,
        elapsed_seconds=verdict.elapsed_seconds,
        origin=verdict.origin,
    )


def skip_reason(root: Path, change: Change) -> str | None:
    """Return why the change needs no review, or None."""
    if is_merge(root):
        return SKIP_MERGE
    if not change.diff.strip():
        return SKIP_EMPTY
    return None


def evaluate(options: CheckOptions) -> tuple[Path, Report]:
    """Run the check the options describe and return root and report."""
    root = repo_root(options.repo)
    paths = rebase_paths(root, options.repo, options.paths)
    scope = Scope(options.mode, paths)
    change = collect_change(root, scope)
    reason = skip_reason(root, change)
    if reason is not None:
        return root, Report(Status.SKIPPED, reason)
    return root, apply_waivers(root, review(root, scope, change))


def report_document(report: Report) -> dict[str, object]:
    """Return the JSON form of a report."""
    return {
        Key.STATUS: report.status,
        Key.REASON: report.reason,
        Key.FINDINGS: [
            {Key.ID: finding.id, **asdict(finding)}
            for finding in report.findings
        ],
        Key.WAIVED: [
            {Key.ID: finding.id, Key.REASON: waiver.reason}
            for finding, waiver in report.waived
        ],
    }


def timing_label(report: Report) -> str:
    """Return how long the review took, or where the verdict came from."""
    if report.origin is Origin.REVIEWED:
        return f"{report.elapsed_seconds:.0f}s"
    return report.origin.value


def count_label(count: int) -> str:
    """Return ``count`` with the matching singular or plural noun."""
    return f"{count} finding" + ("" if count == 1 else "s")


def report_lines(root: Path, report: Report) -> list[str]:
    """Return the terse text form of a report."""
    if report.status is Status.SKIPPED:
        return [f"{PROGRAM}: skipped ({report.reason})"]
    label = timing_label(report)
    lines = []
    if report.findings:
        count = count_label(len(report.findings))
        lines.append(f"{PROGRAM}: {count} ({label})")
    lines.extend(finding.describe() for finding in report.findings)
    lines.extend(
        f"waived: {finding.id} {waiver.reason}"
        for finding, waiver in report.waived
    )
    if report.findings:
        lines.append(WAIVE_HINT.format(repo=root))
    else:
        lines.append(f"{PASS_LINE} ({label})")
    return lines


def print_report(root: Path, report: Report, *, as_json: bool) -> None:
    """Print a report as terse text or as JSON."""
    if as_json:
        print(json.dumps(report_document(report), ensure_ascii=False))
        return
    print(NEWLINE.join(report_lines(root, report)))


def check(options: CheckOptions) -> int:
    """Run ``check`` and return its exit code."""
    if os.environ.get(RECURSION_ENV) == RECURSION_ON:
        report = Report(Status.SKIPPED, SKIP_RECURSION)
        print_report(options.repo, report, as_json=options.json)
        return EXIT_PASS
    try:
        root, report = evaluate(options)
    except GateError as error:
        print(f"{PROGRAM}: {error}", file=sys.stderr)
        return EXIT_ERROR
    print_report(root, report, as_json=options.json)
    return EXIT_FINDINGS if report.status is Status.FINDINGS else EXIT_PASS


def waive(repo: Path, finding_id: str, reason: str) -> int:
    """Record a waiver for one finding and return the exit code."""
    if not reason.strip():
        print(f"{PROGRAM}: a waiver needs a non-empty reason", file=sys.stderr)
        return EXIT_ERROR
    try:
        root = repo_root(repo)
        waivers = load_waivers()
        timestamp = datetime.datetime.now(datetime.UTC).isoformat()
        waivers.setdefault(str(root), {})[finding_id] = Waiver(
            reason.strip(), timestamp
        )
        save_waivers(waivers)
    except (GateError, OSError) as error:
        print(f"{PROGRAM}: {error}", file=sys.stderr)
        return EXIT_ERROR
    print(f"{PROGRAM}: waived {finding_id} in {root}")
    return EXIT_PASS


def mode_of(namespace: argparse.Namespace) -> Mode:
    """Return the scope mode the mutually exclusive flags select."""
    if namespace.staged:
        return Mode.STAGED
    if namespace.tracked:
        return Mode.TRACKED
    return Mode.WORKTREE


def build_parser() -> argparse.ArgumentParser:
    """Return the command-line parser with its two subcommands."""
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    check_parser = commands.add_parser(CHECK_COMMAND, help="review a change")
    check_parser.add_argument("--repo", type=Path, default=Path())
    modes = check_parser.add_mutually_exclusive_group()
    modes.add_argument("--staged", action="store_true", help="the index")
    modes.add_argument(
        "--tracked", action="store_true", help="tracked working tree"
    )
    check_parser.add_argument("--paths", nargs="+", default=[], metavar="P")
    check_parser.add_argument("--json", action="store_true")
    waive_parser = commands.add_parser(WAIVE_COMMAND, help="accept a finding")
    waive_parser.add_argument("--repo", type=Path, default=Path())
    waive_parser.add_argument("--finding", required=True, metavar="ID")
    waive_parser.add_argument("--reason", required=True)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    """Parse the command line, run the subcommand, return the exit code."""
    namespace = build_parser().parse_args(argv)
    if namespace.command == WAIVE_COMMAND:
        return waive(namespace.repo, namespace.finding, namespace.reason)
    options = CheckOptions(
        repo=namespace.repo,
        mode=mode_of(namespace),
        paths=tuple(namespace.paths),
        json=namespace.json,
    )
    return check(options)


if __name__ == "__main__":
    sys.exit(main())
