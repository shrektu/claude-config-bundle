class Language(enum.StrEnum):
    """A language a changed file is written in."""

    PYTHON = "python"
    TYPESCRIPT = "ts"
    JAVASCRIPT = "js"
    C = "c"
    CPP = "cpp"
    LOCALE = "locale"


NON_LOCALE_LANGUAGES = frozenset(Language) - {Language.LOCALE}
LOCALE_SUFFIX = ".json"


SUFFIX_LANGUAGES = {
    ".py": Language.PYTHON,
    ".pyi": Language.PYTHON,
    ".ts": Language.TYPESCRIPT,
    ".tsx": Language.TYPESCRIPT,
    ".mts": Language.TYPESCRIPT,
    ".cts": Language.TYPESCRIPT,
    ".js": Language.JAVASCRIPT,
    ".jsx": Language.JAVASCRIPT,
    ".mjs": Language.JAVASCRIPT,
    ".cjs": Language.JAVASCRIPT,
    ".c": Language.C,
    ".h": Language.C,
    ".cpp": Language.CPP,
    ".cc": Language.CPP,
    ".cxx": Language.CPP,
    ".hpp": Language.CPP,
    ".hh": Language.CPP,
}


class Mode(enum.StrEnum):
    """Which changes are linted."""

    WORKTREE = "working tree vs HEAD"
    BASE = "working tree vs merge-base"
    STAGED = "staged (index vs HEAD)"
    TRACKED = "tracked working tree vs HEAD"


UNTRACKED_MODES = frozenset({Mode.WORKTREE, Mode.BASE})


class TextSource(enum.StrEnum):
    """Where the linted text of a file is read from."""

    DISK = "disk"
    INDEX = "index"


class GitError(Exception):
    """A git command failed; the message carries git's explanation."""


@dataclass(frozen=True, slots=True)
class LintTarget:
    """A changed file, its language and the new-side lines it changed."""

    path: str
    language: Language
    changed_lines: frozenset[int]
    text_source: TextSource


@dataclass(frozen=True, slots=True)
class Violation:
    """A norm violation located on a changed line."""

    path: str
    line: int
    column: int
    rule: str
    message: str
    url: str
    tool: str


@dataclass(frozen=True, slots=True)
class NotChecked:
    """A file a tool could not check, with the reason."""

    path: str
    tool: str
    reason: str


@dataclass(frozen=True, slots=True)
class CollectedTargets:
    """The lint targets of a scope and the files skipped."""

    targets: tuple[LintTarget, ...]
    not_checked: tuple[NotChecked, ...] = ()


@dataclass(frozen=True, slots=True)
class Suppression:
    """An added line that silences a linter."""

    path: str
    line: int
    text: str


@dataclass(frozen=True, slots=True)
class BackendResult:
    """What one backend found in its targets and which tools it ran."""

    violations: tuple[Violation, ...] = ()
    not_checked: tuple[NotChecked, ...] = ()
    tools: tuple[str, ...] = ()


@dataclass(frozen=True, slots=True)
class Report:
    """The complete outcome of one lint-strict run."""

    mode: Mode
    tools: tuple[str, ...]
    target_count: int
    violations: tuple[Violation, ...]
    not_checked: tuple[NotChecked, ...]
    suppressions: tuple[Suppression, ...]
    fix: FixSummary | None = None

    @property
    def passed(self) -> bool:
        """Whether no violation was found."""
        return not self.violations


@dataclass(frozen=True, slots=True)
class Scope:
    """The mode, the optional base ref and the pathspecs of a run."""

    mode: Mode
    base_ref: str | None
    paths: tuple[str, ...]


@dataclass(frozen=True, slots=True)
class DiffEntry:
    """One file from a raw git diff listing."""

    status: str
    path: str
    old_path: str | None
    mode: str


@dataclass(frozen=True, slots=True)
class OutputCap:
    """How many violation lines are printed and where the rest is."""

    max_lines: int
    log_path: Path


@dataclass(frozen=True, slots=True)
class Options:
    """The parsed command line."""

    repo: Path
    scope: Scope
    json: bool
    max_lines: int
    fix: bool = False
    quick: bool = False


def decode(data: bytes) -> str:
    """Decode bytes as UTF-8, replacing undecodable bytes."""
    return data.decode(TEXT_ENCODING, errors=DECODE_ERRORS)


def split_lines(text: str) -> list[str]:
    """Split text on newlines the way git numbers lines."""
    lines = text.split(NEWLINE)
    if lines and not lines[-1]:
        lines.pop()
    return lines


def run_git(
    root: Path,
    *args: str,
    literal_pathspecs: bool = False,
) -> str:
    """Run git in root and return its decoded stdout.

    Raise GitError with git's stderr when git exits non-zero.
    """
    environment = (
        {**os.environ, LITERAL_PATHSPECS_ENV: LITERAL_PATHSPECS_ON}
        if literal_pathspecs
        else None
    )
    done = subprocess.run(
        [GIT, *args],
        cwd=root,
        env=environment,
        capture_output=True,
        check=False,
    )
    if done.returncode != EXIT_PASS:
        message = decode(done.stderr).strip() or f"git {args[0]} failed"
        raise GitError(message)
    return decode(done.stdout)


@dataclass(frozen=True, slots=True)
class Repo:
    """A git work tree whose files are linted."""

    root: Path
    diff_arguments: tuple[str, ...] = ()
    base_ref: str = HEAD
    literal_pathspecs: bool = False
    quick: bool = False

    def git(self, *args: str) -> str:
        """Run git in the work tree and return its stdout."""
        return run_git(
            self.root,
            *args,
            literal_pathspecs=self.literal_pathspecs,
        )

    def read_source(self, path: str, source: TextSource) -> str:
        """Return the text of path from disk or from the index."""
        if source is TextSource.INDEX:
            return self.git("show", f":{path}")
        return decode((self.root / path).read_bytes())

    def read_text(self, target: LintTarget) -> str:
        """Return the text of a target from its text source."""
        return self.read_source(target.path, target.text_source)

    def absolute(self, path: str) -> str:
        """Return the absolute filesystem path of a repo path."""
        return str(self.root / path)

    def absolute_path(self, path: str) -> Path:
        """Return the absolute filesystem path of a repo path as a Path."""
        return self.root / path

    def relative(self, filename: str) -> str:
        """Return the repo path of an absolute filename a tool printed."""
        candidate = Path(filename)
        if candidate.is_relative_to(self.root):
            return candidate.relative_to(self.root).as_posix()
        return candidate.resolve().relative_to(self.root.resolve()).as_posix()


def open_repo(path: Path) -> Repo:
    """Return the repository containing path; raise GitError otherwise."""
    if not path.is_dir():
        message = f"not a directory: {path}"
        raise GitError(message)
    root = run_git(path, "rev-parse", "--show-toplevel").strip()
    return Repo(Path(root))


def has_head(repo: Repo) -> bool:
    """Tell whether the repository has a HEAD commit."""
    try:
        repo.git("rev-parse", "--verify", "--quiet", f"{HEAD}^{{commit}}")
    except GitError:
        return False
    return True


def head_or_empty_tree(repo: Repo) -> str:
    """Return HEAD, or the empty tree in a repository without commits."""
    return HEAD if has_head(repo) else EMPTY_TREE


def base_ref(repo: Repo, scope: Scope) -> str:
    """Return the revision the changes of the scope are measured from."""
    if scope.mode is Mode.BASE:
        return repo.git("merge-base", str(scope.base_ref), HEAD).strip()
    return head_or_empty_tree(repo)


def located_repo(repo: Repo, scope: Scope) -> Repo:
    """Return the repo with the diff arguments and base of the scope."""
    base = base_ref(repo, scope)
    arguments = ("--cached", base) if scope.mode is Mode.STAGED else (base,)
    return replace(repo, diff_arguments=arguments, base_ref=base)


def parse_raw_listing(output: str) -> list[DiffEntry]:
    """Parse `git diff --raw -z` output into diff entries."""
    entries: list[DiffEntry] = []
    tokens = iter(output.split(NUL))
    for meta in tokens:
        if not meta:
            break
        fields = meta.split()
        status = fields[RAW_STATUS_FIELD][0]
        first = next(tokens)
        old_path, path = (
            (first, next(tokens))
            if status in RENAME_OR_COPY
            else (None, first)
        )
        entries.append(
            DiffEntry(status, path, old_path, fields[RAW_NEW_MODE_FIELD]),
        )
    return entries


def parse_hunk_lines(patch: str) -> frozenset[int]:
    """Return the new-side line numbers the hunks of a -U0 patch add."""
    lines: set[int] = set()
    for text in patch.splitlines():
        match = HUNK_HEADER.match(text)
        if match is None:
            continue
        start = int(match.group(1))
        count = (
            DEFAULT_HUNK_COUNT
            if match.group(2) is None
            else int(match.group(2))
        )
        lines.update(range(start, start + count))
    return frozenset(lines)


def language_from(path: str, first_line: str) -> Language | None:
    """Return the language of a file from its suffix or its shebang."""
    pure = PurePosixPath(path)
    suffix = pure.suffix
    if suffix == LOCALE_SUFFIX:
        in_locales = LOCALE_DIRS & set(pure.parts[:-1])
        return Language.LOCALE if in_locales else None
    if suffix:
        return SUFFIX_LANGUAGES.get(suffix)
    if PYTHON_SHEBANG.match(first_line):
        return Language.PYTHON
    if NODE_SHEBANG.match(first_line):
        return Language.JAVASCRIPT
    return None


def first_line_of(repo: Repo, path: str, source: TextSource) -> str:
    """Return the first line of a file without a suffix, else nothing."""
    if PurePosixPath(path).suffix:
        return ""
    lines = split_lines(repo.read_source(path, source))
    return lines[0] if lines else ""


def listed_changes(
    repo: Repo,
    arguments: tuple[str, ...],
    paths: tuple[str, ...],
) -> list[DiffEntry]:
    """List the files the diff arguments change within the pathspecs."""
    output = repo.git(
        "diff",
        *arguments,
        "--raw",
        "-z",
        *DIFF_FLAGS,
        PATHSPEC_SEPARATOR,
        *paths,
    )
    return parse_raw_listing(output)


def changed_lines_of(
    repo: Repo,
    entry: DiffEntry,
    arguments: tuple[str, ...],
) -> frozenset[int]:
    """Return the new-side lines one diff entry changes."""
    names = [name for name in (entry.old_path, entry.path) if name]
    patch = repo.git(
        "--literal-pathspecs",
        "diff",
        *arguments,
        "-U0",
        *DIFF_FLAGS,
        PATHSPEC_SEPARATOR,
        *names,
    )
    return parse_hunk_lines(patch)


def diff_target(
    repo: Repo,
    entry: DiffEntry,
    arguments: tuple[str, ...],
    source: TextSource,
) -> LintTarget | None:
    """Turn a diff entry into a lint target, or None when not lintable."""
    if entry.status == DELETED or entry.mode not in REGULAR_FILE_MODES:
        return None
    first_line = first_line_of(repo, entry.path, source)
    language = language_from(entry.path, first_line)
    if language is None:
        return None
    changed = changed_lines_of(repo, entry, arguments)
    if not changed:
        return None
    return LintTarget(entry.path, language, changed, source)


def unstaged_paths(repo: Repo, paths: tuple[str, ...]) -> frozenset[str]:
    """Return the paths whose working tree differs from the index."""
    output = repo.git(
        "diff",
        "--name-only",
        "-z",
        "--no-ext-diff",
        PATHSPEC_SEPARATOR,
        *paths,
    )
    return frozenset(name for name in output.split(NUL) if name)


def untracked_target(repo: Repo, name: str) -> LintTarget | NotChecked | None:
    """Return the untracked file as a fully changed target, if lintable."""
    disk_path = repo.root / name
    if disk_path.is_symlink() or not disk_path.is_file():
        return None
    try:
        first_line = first_line_of(repo, name, TextSource.DISK)
        language = language_from(name, first_line)
        if language is None:
            return None
        line_count = len(split_lines(repo.read_source(name, TextSource.DISK)))
    except OSError as error:
        reason = FILE_READ_FAILED.format(error=error.strerror or error)
        return NotChecked(name, PROGRAM, reason)
    if not line_count:
        return None
    changed = frozenset(range(1, line_count + 1))
    return LintTarget(name, language, changed, TextSource.DISK)


def untracked_targets(repo: Repo, paths: tuple[str, ...]) -> CollectedTargets:
    """Return the untracked, non-ignored targets and the unreadable files."""
    output = repo.git(
        "ls-files",
        "-z",
        "--others",
        "--exclude-standard",
        PATHSPEC_SEPARATOR,
        *paths,
    )
    names = filter(None, output.split(NUL))
    found = [untracked_target(repo, name) for name in names]
    return CollectedTargets(
        tuple(item for item in found if isinstance(item, LintTarget)),
        tuple(item for item in found if isinstance(item, NotChecked)),
    )


def merged_commit(repo: Repo) -> str | None:
    """Return the commit an unfinished merge brings in, if any."""
    try:
        return repo.git(
            "rev-parse", "--verify", "--quiet", f"{MERGE_HEAD}^{{commit}}"
        ).strip()
    except GitError:
        return None


def written_in_merge(
    repo: Repo,
    target: LintTarget,
    entry: DiffEntry,
    comparison: tuple[str, ...],
) -> LintTarget | None:
    """Keep only the lines the merge result adds over the merged commit."""
    own = target.changed_lines & changed_lines_of(repo, entry, comparison)
    return replace(target, changed_lines=own) if own else None


def collect_targets(repo: Repo, scope: Scope) -> CollectedTargets:
    """Return the lint targets the scope selects, sorted by path."""
    arguments = repo.diff_arguments
    staged = scope.mode is Mode.STAGED
    unstaged = unstaged_paths(repo, scope.paths) if staged else frozenset()
    merged = merged_commit(repo)
    comparison: tuple[str, ...] | None = None
    if merged is not None:
        comparison = (STAGED_ARGUMENT, merged) if staged else (merged,)
    targets: list[LintTarget] = []
    for entry in listed_changes(repo, arguments, scope.paths):
        source = (
            TextSource.INDEX if entry.path in unstaged else TextSource.DISK
        )
        target = diff_target(repo, entry, arguments, source)
        if target is not None and comparison is not None:
            target = written_in_merge(repo, target, entry, comparison)
        if target is not None:
            targets.append(target)
    untracked = CollectedTargets(())
    if scope.mode in UNTRACKED_MODES:
        untracked = untracked_targets(repo, scope.paths)
        targets.extend(untracked.targets)
    return CollectedTargets(
        tuple(sorted(targets, key=lambda target: target.path)),
        untracked.not_checked,
    )


def find_suppressions(
    repo: Repo,
    targets: Sequence[LintTarget],
) -> list[Suppression]:
    """Return the changed lines that add a linter suppression."""
    found: list[Suppression] = []
    for target in targets:
        lines = split_lines(repo.read_text(target))
        for number in sorted(target.changed_lines):
            if number > len(lines):
                continue
            text = lines[number - 1]
            if SUPPRESSION_PATTERN.search(text):
                found.append(Suppression(target.path, number, text.strip()))
    return found


def is_test_file(path: str) -> bool:
    """Tell whether a repo path is a test file exempt from docstrings."""
    pure = PurePosixPath(path)
    if any(
        fnmatch.fnmatch(pure.name, pattern) for pattern in TEST_FILE_PATTERNS
    ):
        return True
    return bool(TEST_DIRECTORIES.intersection(pure.parts[:-1]))


def read_toml(path: Path) -> dict[str, Any]:
    """Return the parsed TOML file, or an empty table when unusable."""
    if not path.is_file():
        return {}
    try:
        return tomllib.loads(decode(path.read_bytes()))
    except tomllib.TOMLDecodeError:
        return {}


def config_directories(root: Path, file: Path) -> Iterator[Path]:
    """Yield the directories from the file's up to the repo root."""
    for directory in file.parents:
        if not directory.is_relative_to(root):
            return
        yield directory


def line_length_in(directory: Path) -> int | None:
    """Return the line length a directory's own config files set."""
    for name in RUFF_CONFIG_FILES:
        value = read_toml(directory / name).get(LINE_LENGTH_KEY)
        if isinstance(value, int):
            return value
    tools = read_toml(directory / PYPROJECT).get("tool", {})
    for section in LINE_LENGTH_SECTIONS:
        settings = tools.get(section, {}) if isinstance(tools, dict) else {}
        value = settings.get(LINE_LENGTH_KEY)
        if isinstance(value, int):
            return value
    return None


def ruff_settings_in(directory: Path) -> tuple[Path, dict[str, Any]] | None:
    """Return a directory's ruff config file and its ruff table."""
    for name in RUFF_CONFIG_FILES:
        path = directory / name
        if path.is_file():
            return path, read_toml(path)
    tools = read_toml(directory / PYPROJECT).get("tool", {})
    settings = tools.get("ruff") if isinstance(tools, dict) else None
    return (
        (directory / PYPROJECT, settings)
        if isinstance(settings, dict)
        else None
    )


def selected_ruff_rules(
    settings: dict[str, Any],
    keys: tuple[str, ...] = RUFF_SELECT_KEYS,
) -> list[str]:
    """Return the rule selectors a ruff table lists under the keys."""
    lint = settings.get(RUFF_LINT_SECTION, {})
    tables = [settings, lint] if isinstance(lint, dict) else [settings]
    return [
        str(rule)
        for table in tables
        for key in keys
        if isinstance(table.get(key), list)
        for rule in table[key]
    ]


def selects_any(
    path: Path,
    settings: dict[str, Any],
    selectors: frozenset[str],
    depth: int,
) -> bool:
    """Return whether a ruff config, or one it extends, selects any."""
    if not selectors.isdisjoint(selected_ruff_rules(settings)):
        return True
    extended = settings.get(RUFF_EXTEND_KEY)
    if not isinstance(extended, str) or depth >= MAX_RUFF_EXTEND_DEPTH:
        return False
    base = path.parent / extended
    return selects_any(base, read_toml(base), selectors, depth + 1)


def resolve_typing_only_imports(root: Path, file: Path) -> bool:
    """Return whether the nearest ruff config opts into TC001-003."""
    for directory in config_directories(root, file):
        found = ruff_settings_in(directory)
        if found is not None:
            return selects_any(*found, RUFF_TYPING_ONLY_IMPORT_SELECTORS, 0)
    return False


def resolve_module_docstrings_required(root: Path, file: Path) -> bool:
    """Return whether the nearest ruff config requires module docstrings."""
    for directory in config_directories(root, file):
        found = ruff_settings_in(directory)
        if found is None:
            continue
        path, settings = found
        ignored = selected_ruff_rules(settings, RUFF_IGNORE_KEYS)
        return selects_any(
            path,
            settings,
            RUFF_MODULE_DOCSTRING_SELECTORS,
            0,
        ) and RUFF_MODULE_DOCSTRING_IGNORES.isdisjoint(ignored)
    return False


def toml_literal(value: object) -> str | None:
    """Return the TOML text of a bool, int, str or list of str."""
    if isinstance(value, bool | int | str):
        return json.dumps(value)
    if isinstance(value, list) and all(isinstance(i, str) for i in value):
        return f"[{', '.join(json.dumps(item) for item in value)}]"
    return None


def resolve_isort_arguments(root: Path, file: Path) -> tuple[str, ...]:
    """Return the ruff --config flags for the nearest lint.isort table."""
    for directory in config_directories(root, file):
        found = ruff_settings_in(directory)
        if found is None:
            continue
        settings = found[1]
        lint = settings.get(RUFF_LINT_SECTION, {})
        table = (
            lint.get(RUFF_ISORT_SECTION) if isinstance(lint, dict) else None
        ) or settings.get(RUFF_ISORT_SECTION)
        if not isinstance(table, dict):
            return ()
        return tuple(
            argument
            for key, value in table.items()
            if (literal := toml_literal(value)) is not None
            for argument in (
                RUFF_CONFIG_FLAG,
                f"{RUFF_LINT_SECTION}.{RUFF_ISORT_SECTION}.{key}={literal}",
            )
        )
    return ()


def resolve_line_length(root: Path, file: Path) -> int:
    """Return the nearest configured line length capped at 99, else 79."""
    for directory in config_directories(root, file):
        configured = line_length_in(directory)
        if configured is not None:
            return min(configured, MAX_LINE_LENGTH)
    return DEFAULT_LINE_LENGTH


def requires_python_minor(requirement: str) -> int | None:
    """Return the minor version of the lower bound of requires-python."""
    match = REQUIRES_PYTHON_MINOR.search(requirement)
    return None if match is None else int(match.group(1))


def required_minor_in(directory: Path) -> int | None:
    """Return the requires-python minor a directory's pyproject sets."""
    project = read_toml(directory / PYPROJECT).get("project", {})
    requirement = (
        project.get("requires-python") if isinstance(project, dict) else None
    )
    if not isinstance(requirement, str):
        return None
    return requires_python_minor(requirement)


def pinned_minor_in(directory: Path) -> int | None:
    """Return the Python minor a directory pins."""
    try:
        version = (directory / PYTHON_VERSION_FILE).read_text().strip()
    except (OSError, UnicodeDecodeError):
        version = ""
    if match := PYTHON_VERSION_FILE_MINOR.match(version):
        return int(match.group(1))
    try:
        dockerfile = (directory / DOCKERFILE).read_text()
    except (OSError, UnicodeDecodeError):
        return None
    if match := DOCKERFILE_PYTHON_MINOR.search(dockerfile):
        return int(match.group(1))
    return None


def resolve_target_version(root: Path, file: Path) -> str:
    """Return the target from requires-python, a pin, else python3."""
    directories = list(config_directories(root, file))
    minor = next(
        (
            found
            for finder in (required_minor_in, pinned_minor_in)
            for directory in directories
            if (found := finder(directory)) is not None
        ),
        sys.version_info.minor,
    )
    return f"{TARGET_VERSION_PREFIX}{minor}"


@dataclass(frozen=True, slots=True)
class PythonStyle:
    """The line length and target version a Python file is held to."""

    line_length: int
    target_version: str
    typing_only_imports: bool = False
    module_docstrings_required: bool = False
    isort_arguments: tuple[str, ...] = ()


def python_style(repo: Repo, target: LintTarget) -> PythonStyle:
    """Resolve the style of a target from the configs nearest to it."""
    file = repo.absolute_path(target.path)
    return PythonStyle(
        resolve_line_length(repo.root, file),
        resolve_target_version(repo.root, file),
        resolve_typing_only_imports(repo.root, file),
        resolve_module_docstrings_required(repo.root, file),
        resolve_isort_arguments(repo.root, file),
    )


def usable_executable(path: Path) -> str | None:
    """Return path as a string when it is an executable file."""
    usable = path.is_file() and os.access(path, os.X_OK)
    return str(path) if usable else None


def find_tool(environment: str, name: str) -> str | None:
    """Return a tool from its environment override, else from PATH."""
    configured = os.environ.get(environment)
    if configured:
        return usable_executable(Path(configured))
    return shutil.which(name)


def tool_version(executable: str, name: str, cwd: Path) -> str:
    """Return "name version" from the tool's --version output."""
    return command_version((executable,), name, cwd)


def command_version(command: Sequence[str], name: str, cwd: Path) -> str:
    """Return "name version" from the --version output of a command."""
    done = run_tool([*command, "--version"], cwd)
    match = VERSION_NUMBER.search(decode(done.stdout)) if done else None
    return f"{name} {match.group(1)}" if match else name


def run_tool(
    argv: Sequence[str],
    cwd: Path,
    stdin: str | None = None,
    env: Mapping[str, str] | None = None,
) -> subprocess.CompletedProcess[bytes] | None:
    """Run a tool and return its outcome, or None when it cannot start."""
    try:
        return subprocess.run(
            list(argv),
            cwd=cwd,
            env=env,
            input=None if stdin is None else stdin.encode(TEXT_ENCODING),
            capture_output=True,
            check=False,
        )
    except OSError:
        return None


@functools.cache
def resolved_version(executable: str, name: str, cwd: Path) -> str:
    """Return the tool version, asked once per run."""
    return tool_version(executable, name, cwd)


def cache_directory(name: str) -> Path:
    """Return a subdirectory of the lint-strict cache root."""
    configured = os.environ.get(CACHE_DIR_ENV)
    root = Path(configured) if configured else DEFAULT_CACHE_ROOT
    return root / name


@functools.cache
def executable_identity(executable: str, cwd: Path) -> str:
    """Return the raw --version output, which tells prereleases apart."""
    done = run_tool([executable, "--version"], cwd)
    if done is None or done.returncode != EXIT_PASS:
        return ""
    return decode(done.stdout).strip()


def cache_key(*parts: str) -> str:
    """Return the digest that names a cache entry made from the parts."""
    return hashlib.sha256(NUL.join(parts).encode(TEXT_ENCODING)).hexdigest()


def cache_load(directory: Path, key: str) -> object | None:
    """Return the JSON of a cache entry, None when absent or corrupt."""
    try:
        text = (directory / f"{key}{CACHE_SUFFIX}").read_text(TEXT_ENCODING)
        document: object = json.loads(text)
    except (OSError, ValueError, RecursionError):
        return None
    with suppress(OSError):
        os.utime(directory / f"{key}{CACHE_SUFFIX}")
    return document


def is_temporary_entry(name: str) -> bool:
    """Tell whether a cache file is a temporary one, not a finished entry."""
    if name.endswith(CACHE_TEMP_SUFFIX):
        return True
    return name.endswith(TSC_BUILDINFO_SUFFIX) and name.count(".") > 1


def remove_if_stale(entry: Path, now: float) -> None:
    """Delete a cache file that outlived its age limit; ignore failures."""
    limit = (
        CACHE_TEMP_MAX_AGE_SECONDS
        if is_temporary_entry(entry.name)
        else CACHE_ENTRY_MAX_AGE_SECONDS
    )
    with suppress(OSError):
        if entry.is_file() and now - entry.stat().st_mtime > limit:
            entry.unlink(missing_ok=True)


def prune_cache(directory: Path) -> None:
    """Delete stale files of a cache directory, at most once per interval."""
    now = time.time()
    marker = directory / CACHE_PRUNE_MARKER
    with suppress(OSError):
        if now - marker.stat().st_mtime < CACHE_PRUNE_INTERVAL_SECONDS:
            return
    with suppress(OSError):
        directory.mkdir(parents=True, exist_ok=True)
        marker.touch()
        for entry in directory.iterdir():
            if entry.name != CACHE_PRUNE_MARKER:
                remove_if_stale(entry, now)


def cache_store(directory: Path, key: str, document: object) -> None:
    """Replace a cache entry atomically; a failed write is ignored."""
    temporary = directory / f"{key}.{uuid.uuid4().hex}{CACHE_TEMP_SUFFIX}"
    prune_cache(directory)
    try:
        directory.mkdir(parents=True, exist_ok=True)
        temporary.write_text(json.dumps(document), TEXT_ENCODING)
        temporary.replace(directory / f"{key}{CACHE_SUFFIX}")
    except (OSError, TypeError, ValueError):
        with suppress(OSError):
            temporary.unlink(missing_ok=True)


def heavy_slot_count() -> int:
    """Return how many heavy tools may run at once, 0 when unlimited."""
    configured = os.environ.get(HEAVY_SLOTS_ENV, str(HEAVY_SLOTS_DEFAULT))
    try:
        return max(int(configured), 0)
    except ValueError:
        return HEAVY_SLOTS_DEFAULT


def lock_slot(path: Path) -> int | None:
    """Lock a slot file and return its descriptor, None when it is taken."""
    descriptor = os.open(path, os.O_CREAT | os.O_RDWR, SLOT_FILE_MODE)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as error:
        os.close(descriptor)
        if isinstance(error, BlockingIOError):
            return None
        raise
    return descriptor


def acquire_slot(count: int) -> int | None:
    """Wait for a free heavy-tool slot, None when the wait runs out."""
    directory = cache_directory(SLOTS_CACHE)
    directory.mkdir(parents=True, exist_ok=True)
    deadline = time.monotonic() + HEAVY_SLOT_MAX_WAIT_SECONDS
    while True:
        for number in range(count):
            descriptor = lock_slot(directory / f"{number}{SLOT_SUFFIX}")
            if descriptor is not None:
                return descriptor
        if time.monotonic() >= deadline:
            return None
        time.sleep(HEAVY_SLOT_POLL_SECONDS)


@contextmanager
def heavy_slot() -> Iterator[None]:
    """Hold a cross-process heavy-tool slot, run without one on failure."""
    count = heavy_slot_count()
    descriptor: int | None = None
    if count > 0:
        with suppress(OSError):
            descriptor = acquire_slot(count)
    try:
        yield
    finally:
        if descriptor is not None:
            os.close(descriptor)


def failure_reason(stderr: bytes, fallback: str) -> str:
    """Return the most telling line of a tool's stderr."""
    lines = [line.strip() for line in decode(stderr).splitlines()]
    errors = [line for line in lines if ERROR_MARKER in line.lower()]
    meaningful = errors or [line for line in lines if line]
    return meaningful[0] if meaningful else fallback


@dataclass(frozen=True, slots=True)
class RuffSettings:
    """The ruff executable and the options every ruff run shares."""

    executable: str
    version: str

    def check_command(
        self,
        style: PythonStyle,
        *,
        test_file: bool,
    ) -> list[str]:
        """Return the ruff check argv for normal or test files."""
        ignored = (
            RUFF_IGNORED
            + (RUFF_TEST_IGNORED if test_file else ())
            + (
                ()
                if style.typing_only_imports
                else RUFF_TYPING_ONLY_IMPORT_RULES
            )
        )
        return [
            self.executable,
            "check",
            "--isolated",
            "--no-cache",
            "--select",
            "ALL",
            "--ignore",
            ",".join(ignored),
            *RUFF_CONFIG_ARGUMENTS,
            *RUFF_PREVIEW_ARGUMENTS,
            "--line-length",
            str(style.line_length),
            "--target-version",
            style.target_version,
            "--output-format",
            "json",
            *style.isort_arguments,
        ]

    def format_command(self, style: PythonStyle, filename: str) -> list[str]:
        """Return the ruff format argv printing the formatted stdin."""
        return [
            self.executable,
            "format",
            "--isolated",
            "--no-cache",
            "--line-length",
            str(style.line_length),
            "--target-version",
            style.target_version,
            STDIN_FILENAME_OPTION,
            filename,
            STDIN_MARKER,
        ]


@dataclass(frozen=True, slots=True)
class RuffBatch:
    """Targets checked by one ruff process, from disk or from stdin."""

    targets: tuple[LintTarget, ...]
    style: PythonStyle
    test_file: bool
    stdin: str | None


def ruff_batches(
    repo: Repo,
    targets: Sequence[LintTarget],
    styles: dict[str, PythonStyle],
) -> list[RuffBatch]:
    """Group disk targets by style and test class; index blobs one each."""
    groups: dict[tuple[PythonStyle, bool], list[LintTarget]] = {}
    batches: list[RuffBatch] = []
    for target in targets:
        style = styles[target.path]
        test_file = is_test_file(target.path)
        if target.text_source is TextSource.INDEX:
            text = repo.read_text(target)
            batches.append(RuffBatch((target,), style, test_file, text))
        else:
            groups.setdefault((style, test_file), []).append(target)
    batches.extend(
        RuffBatch(tuple(group), style, test_file, None)
        for (style, test_file), group in groups.items()
    )
    return batches


def violation_from_ruff(item: dict[str, Any], path: str) -> Violation:
    """Convert one ruff JSON diagnostic into a violation."""
    location = item.get("location") or {}
    return Violation(
        path=path,
        line=int(location.get("row", MODULE_LINE)),
        column=int(location.get("column", DOCSTRING_COLUMN)),
        rule=item.get("code") or RUFF_SYNTAX_RULE,
        message=str(item.get("message", "")),
        url=item.get("url") or "",
        tool=RUFF_TOOL,
    )


def stdin_arguments(filename: str) -> list[str]:
    """Return the ruff arguments reading one file's text from stdin."""
    return [STDIN_FILENAME_OPTION, filename, STDIN_MARKER]


def ruff_items(
    done: subprocess.CompletedProcess[bytes] | None,
) -> list[dict[str, Any]] | None:
    """Return the JSON diagnostics of a ruff run, None when unreadable."""
    try:
        items = json.loads(decode(done.stdout)) if done else None
    except json.JSONDecodeError:
        return None
    return items if isinstance(items, list) else None


def run_ruff_batch(
    settings: RuffSettings,
    repo: Repo,
    batch: RuffBatch,
) -> BackendResult:
    """Run ruff check on one batch and keep findings on changed lines."""
    command = settings.check_command(batch.style, test_file=batch.test_file)
    if batch.stdin is None:
        command.extend(repo.absolute(t.path) for t in batch.targets)
    else:
        command.extend(stdin_arguments(repo.absolute(batch.targets[0].path)))
    done = run_tool(command, repo.root, batch.stdin)
    items = ruff_items(done)
    if items is None:
        reason = failure_reason(done.stderr, RUFF_FAILED) if done else ""
        return BackendResult(
            not_checked=tuple(
                NotChecked(t.path, RUFF_TOOL, reason or RUFF_FAILED)
                for t in batch.targets
            ),
        )
    by_path = {target.path: target for target in batch.targets}
    found = [
        violation_from_ruff(item, repo.relative(item["filename"]))
        for item in items
    ]
    return BackendResult(
        violations=tuple(
            violation
            for violation in found
            if violation.path in by_path
            and violation.line in by_path[violation.path].changed_lines
        ),
    )


@dataclass(frozen=True, slots=True)
class Drift:
    """A formatter change touching changed lines."""

    line: int
    first: int
    last: int


class Opcode(NamedTuple):
    """One difflib opcode turning original lines into formatted ones."""

    tag: str
    start: int
    end: int
    new_start: int
    new_end: int


def opcode_lines(opcode: Opcode) -> range:
    """Return the 1-based original line numbers an opcode covers."""
    return range(opcode.start + MODULE_LINE, opcode.end + MODULE_LINE)


def insertion_anchor(opcode: Opcode) -> int:
    """Return the original line an insertion is attached to."""
    return max(opcode.start, MODULE_LINE)


def opcode_fully_changed(opcode: Opcode, changed: frozenset[int]) -> bool:
    """Tell whether every original line an opcode covers is changed."""
    if opcode.tag == INSERT_OPCODE:
        return insertion_anchor(opcode) in changed
    return changed.issuperset(opcode_lines(opcode))


def line_opcodes(
    original: Sequence[str],
    formatted: Sequence[str],
) -> list[Opcode]:
    """Return the difflib opcodes between two lists of lines."""
    matcher = difflib.SequenceMatcher(
        a=list(original),
        b=list(formatted),
        autojunk=False,
    )
    return [Opcode(*opcode) for opcode in matcher.get_opcodes()]


def formatting_drift(
    original: Sequence[str],
    formatted: Sequence[str],
    changed: frozenset[int],
) -> list[Drift]:
    """Attribute formatter changes to original lines via difflib opcodes.

    A pure insertion is attributed to the lines around the insertion point.
    """
    drifts: list[Drift] = []
    for opcode in line_opcodes(original, formatted):
        if opcode.tag == EQUAL_OPCODE:
            continue
        start = opcode.start
        affected = (
            range(start, start + INSERTION_SPAN)
            if start == opcode.end
            else opcode_lines(opcode)
        )
        hits = [line for line in affected if line in changed]
        if hits:
            first = max(affected[0], MODULE_LINE)
            drifts.append(Drift(hits[0], first, affected[-1]))
    return drifts


def format_findings(
    settings: RuffSettings,
    repo: Repo,
    target: LintTarget,
    style: PythonStyle,
) -> list[Violation]:
    """Return an FMT violation per formatter change on changed lines."""
    original = repo.read_text(target)
    done = run_tool(
        settings.format_command(style, repo.absolute(target.path)),
        repo.root,
        original,
    )
    if done is None or done.returncode != EXIT_PASS:
        return []
    return drift_violations(
        target,
        original,
        decode(done.stdout),
        RUFF_FORMAT_TOOL,
    )


def drift_violations(
    target: LintTarget,
    original: str,
    formatted: str,
    formatter: str,
) -> list[Violation]:
    """Return an FMT violation per formatter change on changed lines."""
    drifts = formatting_drift(
        split_lines(original),
        split_lines(formatted),
        target.changed_lines,
    )
    return [
        Violation(
            path=target.path,
            line=drift.line,
            column=FORMAT_COLUMN,
            rule=FORMAT_RULE,
            message=FORMAT_MESSAGE.format(
                tool=formatter,
                first=drift.first,
                last=drift.last,
            ),
            url="",
            tool=formatter,
        )
        for drift in drifts
    ]


@dataclass(frozen=True, slots=True)
class MissingDocstring:
    """A class or function without a docstring."""

    line: int
    message: str


DEFINITION_KINDS = {
    ast.ClassDef: "class",
    ast.FunctionDef: "function",
    ast.AsyncFunctionDef: "function",
}
DEFINITION_TYPES = (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)


def is_overload(
    node: ast.FunctionDef | ast.AsyncFunctionDef | ast.ClassDef,
) -> bool:
    """Tell whether a definition is an @overload stub."""
    for decorator in node.decorator_list:
        match decorator:
            case ast.Name(id=name) | ast.Attribute(attr=name):
                if name == OVERLOAD:
                    return True
    return False


def missing_docstrings(text: str) -> list[MissingDocstring]:
    """Return every class or function of the source lacking a docstring."""
    tree = parse_python(text)
    if tree is None:
        return []
    missing: list[MissingDocstring] = []
    for node in ast.walk(tree):
        if not isinstance(node, tuple(DEFINITION_KINDS)):
            continue
        if is_overload(node) or ast.get_docstring(node) is not None:
            continue
        kind = DEFINITION_KINDS[type(node)]
        message = DOCSTRING_MESSAGE.format(kind=kind, name=node.name)
        missing.append(MissingDocstring(node.lineno, message))
    return missing


@dataclass(frozen=True, slots=True, order=True)
class ShapeProblem:
    """A docstring that breaks the one-line, one-sentence policy."""

    line: int
    rule: str
    message: str


def is_one_line_sentence(text: str) -> bool:
    """Tell whether a cleaned docstring is one short one-line sentence."""
    return (
        "\n" not in text
        and len(text) <= MAX_DOCSTRING_LENGTH
        and SENTENCE_END.search(text) is None
    )


def badly_shaped_docstrings(text: str) -> list[ShapeProblem]:
    """Return module docstrings and badly shaped definition docstrings."""
    tree = parse_python(text)
    if tree is None:
        return []
    problems: list[ShapeProblem] = []
    if ast.get_docstring(tree) is not None:
        problems.append(
            ShapeProblem(
                tree.body[0].lineno,
                MODULE_SHAPE_RULE,
                MODULE_SHAPE_MESSAGE,
            ),
        )
    for node in ast.walk(tree):
        if not isinstance(node, DEFINITION_TYPES):
            continue
        docstring = ast.get_docstring(node)
        if docstring is None or is_one_line_sentence(docstring):
            continue
        problems.append(
            ShapeProblem(node.body[0].lineno, SHAPE_RULE, SHAPE_MESSAGE),
        )
    return sorted(problems)


def is_stub_file(path: str) -> bool:
    """Tell whether a repo path is a type stub, which carries no docstrings."""
    return PurePosixPath(path).suffix == STUB_SUFFIX


def docstring_findings(
    repo: Repo,
    targets: Sequence[LintTarget],
) -> list[Violation]:
    """Return DOC100 for undocumented definitions on changed lines."""
    return [
        Violation(
            path=target.path,
            line=missing.line,
            column=DOCSTRING_COLUMN,
            rule=DOCSTRING_RULE,
            message=missing.message,
            url="",
            tool=DOCSTRING_TOOL,
        )
        for target in targets
        if not is_test_file(target.path) and not is_stub_file(target.path)
        for missing in missing_docstrings(repo.read_text(target))
        if missing.line in target.changed_lines
    ]


def docstring_shape_findings(
    repo: Repo,
    targets: Sequence[LintTarget],
) -> list[Violation]:
    """Return DOC101 and DOC102 for docstrings on changed lines."""
    return [
        Violation(
            path=target.path,
            line=problem.line,
            column=DOCSTRING_COLUMN,
            rule=problem.rule,
            message=problem.message,
            url="",
            tool=DOCSTRING_TOOL,
        )
        for target in targets
        if not is_stub_file(target.path)
        for problem in badly_shaped_docstrings(repo.read_text(target))
        if problem.line in target.changed_lines
        and not (
            problem.rule == MODULE_SHAPE_RULE
            and python_style(repo, target).module_docstrings_required
        )
    ]


def without_ruff_duplicates(
    documentation: Sequence[Violation],
    ruff_found: Sequence[Violation],
) -> list[Violation]:
    """Drop DOC100 findings ruff already reported as D1xx."""
    reported = {
        (violation.path, violation.line)
        for violation in ruff_found
        if violation.rule.startswith(RUFF_DOCSTRING_PREFIX)
    }
    return [
        violation
        for violation in documentation
        if (violation.path, violation.line) not in reported
    ]


def merge_results(results: Sequence[BackendResult]) -> BackendResult:
    """Concatenate backend results into one."""
    return BackendResult(
        violations=tuple(v for result in results for v in result.violations),
        not_checked=tuple(n for result in results for n in result.not_checked),
        tools=tuple(t for result in results for t in result.tools),
    )


class Backend(Protocol):
    """A linter for some languages, run on the targets of those languages."""

    @property
    def name(self) -> str:
        """Return the backend name."""
        ...

    @property
    def languages(self) -> frozenset[Language]:
        """Return the languages this backend lints."""
        ...

    def run(self, repo: Repo, targets: Sequence[LintTarget]) -> BackendResult:
        """Lint the targets and report findings on their changed lines."""
        ...

    def fix(
        self,
        repo: Repo,
        snapshots: Sequence[Snapshot],
        /,
    ) -> dict[str, str]:
        """Return the fixed text of each snapshot the backend can fix."""
        ...


def ruff_and_docstring_results(
    repo: Repo,
    targets: Sequence[LintTarget],
) -> BackendResult:
    """Lint Python targets with ruff check, ruff format and the docstrings."""
    documentation = [
        *docstring_findings(repo, targets),
        *docstring_shape_findings(repo, targets),
    ]
    executable = find_tool(RUFF_ENV, RUFF_TOOL)
    if executable is None:
        return BackendResult(
            violations=tuple(documentation),
            not_checked=tuple(
                NotChecked(target.path, RUFF_TOOL, RUFF_NOT_FOUND)
                for target in targets
            ),
            tools=(f"{RUFF_TOOL}: not found",),
        )
    settings = RuffSettings(
        executable,
        tool_version(executable, RUFF_TOOL, repo.root),
    )
    styles = {t.path: python_style(repo, t) for t in targets}
    checked = merge_results(
        [
            run_ruff_batch(settings, repo, batch)
            for batch in ruff_batches(repo, targets, styles)
        ],
    )
    formatted = [
        violation
        for t in targets
        for violation in format_findings(
            settings,
            repo,
            t,
            styles[t.path],
        )
    ]
    documented = without_ruff_duplicates(documentation, checked.violations)
    return BackendResult(
        violations=(*checked.violations, *formatted, *documented),
        not_checked=checked.not_checked,
        tools=(settings.version,),
    )


@dataclass(frozen=True, slots=True)
class TypeDiagnostic:
    """One type checker error: its file, position, rule and message."""

    path: str
    line: int
    column: int
    rule: str
    message: str


def mypy_diagnostic(match: re.Match[str]) -> TypeDiagnostic:
    """Convert one matched mypy error line into a diagnostic."""
    code = match["code"]
    return TypeDiagnostic(
        path=match["path"],
        line=int(match["line"]),
        column=int(match["column"] or FORMAT_COLUMN),
        rule=f"{MYPY_RULE_PREFIX}{code}" if code else MYPY_TOOL,
        message=match["message"],
    )


def parse_mypy(output: str) -> list[TypeDiagnostic]:
    """Return the errors of mypy's text output; notes are dropped."""
    matches = (MYPY_LINE.match(line) for line in output.splitlines())
    return [mypy_diagnostic(match) for match in matches if match is not None]


def targets_by_file(
    repo: Repo,
    targets: Sequence[LintTarget],
) -> dict[Path, LintTarget]:
    """Map the resolved filesystem path of each target to the target."""
    return {repo.absolute_path(t.path).resolve(): t for t in targets}


def type_violations(
    files: dict[Path, LintTarget],
    base: Path,
    diagnostics: Sequence[TypeDiagnostic],
    tool: str,
) -> tuple[Violation, ...]:
    """Turn the errors on the targets' changed lines into violations.

    Diagnostic paths are resolved against base; errors in other files are
    dropped.
    """
    return tuple(
        Violation(
            path=target.path,
            line=diagnostic.line,
            column=diagnostic.column,
            rule=diagnostic.rule,
            message=diagnostic.message,
            url="",
            tool=tool,
        )
        for diagnostic in diagnostics
        if (target := files.get(resolve_against(base, diagnostic.path)))
        and diagnostic.line in target.changed_lines
    )


def mypy_importable(python: str, cwd: Path) -> bool:
    """Tell whether the interpreter can import mypy."""
    done = run_tool([python, *MYPY_IMPORT_PROBE], cwd)
    return done is not None and done.returncode == EXIT_PASS


def mypy_command(repo: Repo, root: Path) -> tuple[str, ...] | None:
    """Return the argv prefix running mypy for the root, or None."""
    venv_python = usable_executable(root / VENV_PYTHON) or usable_executable(
        repo.root / VENV_PYTHON
    )
    interpreter = venv_python or shutil.which(SYSTEM_PYTHON)
    options = (
        () if interpreter is None else (PYTHON_EXECUTABLE_OPTION, interpreter)
    )
    uvx_python = (
        () if interpreter is None else (UVX_PYTHON_OPTION, interpreter)
    )
    configured = os.environ.get(MYPY_ENV)
    if configured:
        executable = usable_executable(Path(configured).absolute())
        return None if executable is None else (executable, *options)
    if venv_python is not None and mypy_importable(venv_python, root):
        return (venv_python, *MYPY_MODULE_ARGUMENTS, *options)
    uvx = shutil.which(UVX_TOOL)
    return None if uvx is None else (uvx, *uvx_python, MYPY_TOOL, *options)


def mypy_cache_dir(root: Path) -> Path:
    """Return the mypy cache directory of the root, outside the work tree."""
    digest = hashlib.sha256(str(root).encode(TEXT_ENCODING)).hexdigest()
    return MYPY_CACHE_ROOT / digest[:CACHE_KEY_LENGTH]


def mypy_shadows(
    repo: Repo,
    targets: Sequence[LintTarget],
    scratch: Path,
) -> list[str]:
    """Write the index text of index targets and return --shadow-file args."""
    arguments: list[str] = []
    for index, target in enumerate(targets):
        if target.text_source is not TextSource.INDEX:
            continue
        shadow = scratch / str(index) / PurePosixPath(target.path).name
        shadow.parent.mkdir()
        shadow.write_text(repo.read_text(target), encoding=TEXT_ENCODING)
        arguments.extend(
            (MYPY_SHADOW_OPTION, repo.absolute(target.path), str(shadow)),
        )
    return arguments


def mypy_incomplete(
    returncode: int,
    *,
    parsed: bool,
    reported: bool,
) -> bool:
    """Tell whether a finished mypy run left the targets unchecked.

    Exit 1 means errors were found and must have been parsed; exit 2 and
    above is a blocking error that only a reported violation explains.
    """
    if returncode == EXIT_PASS:
        return False
    if returncode >= TOOL_FAILURE_EXIT:
        return not reported
    return not parsed


def explicit_override_options(
    repo: Repo, targets: Sequence[LintTarget]
) -> tuple[str, ...]:
    """Return the explicit-override option when every target allows it."""
    resolver = floor_resolver(repo)
    allowed = bool(targets) and all(
        resolver.python_floors(target.path).python_at_least(
            PYTHON_EXPLICIT_OVERRIDE_MINOR
        )
        for target in targets
    )
    return MYPY_EXPLICIT_OVERRIDE_OPTIONS if allowed else ()


def subproject_root(repo: Repo, target: LintTarget) -> Path:
    """Return the nearest pyproject directory below the repo root, or root."""
    for directory in repo.absolute_path(target.path).parents:
        if directory == repo.root:
            break
        if (directory / PYPROJECT).is_file():
            return directory
    return repo.root


def toml_section(document: Mapping[str, Any], *keys: str) -> dict[str, Any]:
    """Return the nested table at keys, or an empty one when absent."""
    section: Any = document
    for key in keys:
        section = section.get(key) if isinstance(section, dict) else None
    return section if isinstance(section, dict) else {}


def normalized_project_name(name: str) -> str:
    """Return the PEP 503 normalized form of a project name."""
    return PEP503_SEPARATORS.sub("-", name).lower()


def workspace_members(repo: Repo) -> dict[str, Path]:
    """Map normalized project names to uv workspace member directories."""
    workspace = toml_section(
        read_toml(repo.root / PYPROJECT), "tool", "uv", "workspace"
    )
    excluded = {
        path
        for pattern in workspace.get("exclude", ())
        for path in repo.root.glob(pattern)
    }
    members: dict[str, Path] = {}
    for pattern in workspace.get("members", ()):
        for directory in sorted(repo.root.glob(pattern)):
            project = toml_section(read_toml(directory / PYPROJECT), "project")
            name = project.get("name")
            if directory not in excluded and isinstance(name, str):
                members[normalized_project_name(name)] = directory
    return members


def member_import_root(directory: Path) -> Path:
    """Return the directory a workspace member's packages import from."""
    source = directory / SOURCE_DIRECTORY
    if source.is_dir() and not (source / INIT_FILE).exists():
        return source
    return directory


def declared_workspace_roots(
    repo: Repo, document: Mapping[str, Any]
) -> list[Path]:
    """Return the import roots of the workspace sources a project declares."""
    members = workspace_members(repo)
    sources = toml_section(document, "tool", "uv", "sources")
    roots: list[Path] = []
    for name, source in sources.items():
        member = members.get(normalized_project_name(name))
        if member and isinstance(source, dict) and source.get("workspace"):
            roots.append(member_import_root(member))
    return roots


def pytest_python_paths(root: Path, document: Mapping[str, Any]) -> list[Path]:
    """Return the pytest pythonpath entries, except the root itself."""
    options = toml_section(document, "tool", "pytest", "ini_options")
    configured = options.get("pythonpath", ())
    entries = [configured] if isinstance(configured, str) else configured
    paths = [root / entry for entry in entries if isinstance(entry, str)]
    return [path for path in paths if path.resolve() != root.resolve()]


def is_test_module(path: str) -> bool:
    """Tell whether a repo path is named like a test module."""
    name = PurePosixPath(path).name
    return any(
        fnmatch.fnmatch(name, pattern) for pattern in TEST_FILE_PATTERNS
    )


def pytest_sibling_roots(
    repo: Repo,
    root: Path,
    targets: Sequence[LintTarget],
) -> list[Path]:
    """Return the test directories pytest prepend mode puts on sys.path."""
    return [
        directory
        for directory in (
            repo.absolute_path(target.path).parent
            for target in targets
            if is_test_module(target.path)
        )
        if directory != root and not (directory / INIT_FILE).exists()
    ]


def mypy_search_path(
    repo: Repo,
    root: Path,
    targets: Sequence[LintTarget],
    *,
    with_siblings: bool = True,
) -> tuple[Path, ...]:
    """Return the import roots mypy needs besides the project root."""
    document = read_toml(root / PYPROJECT)
    sibling_directories = (
        pytest_sibling_roots(repo, root, targets) if with_siblings else []
    )
    return tuple(
        dict.fromkeys(
            [
                *declared_workspace_roots(repo, document),
                *pytest_python_paths(root, document),
                *sibling_directories,
            ]
        )
    )


def mypy_environment(search_path: Sequence[Path]) -> dict[str, str] | None:
    """Return the environment giving mypy the search path, None if empty."""
    inherited = os.environ.get(MYPYPATH_ENV)
    parts = [*map(str, search_path), *([inherited] if inherited else [])]
    if not parts:
        return None
    return {**os.environ, MYPYPATH_ENV: os.pathsep.join(parts)}


def run_mypy(
    argv: Sequence[str],
    repo: Repo,
    root: Path,
    targets: Sequence[LintTarget],
) -> subprocess.CompletedProcess[bytes] | None:
    """Run mypy, once more without test roots after a module name clash."""
    done = run_tool(
        argv,
        root,
        env=mypy_environment(mypy_search_path(repo, root, targets)),
    )
    if done is None or MYPY_DUPLICATE_MODULE not in decode(
        done.stderr + done.stdout
    ):
        return done
    return run_tool(
        argv,
        root,
        env=mypy_environment(
            mypy_search_path(repo, root, targets, with_siblings=False)
        ),
    )


def mypy_group_results(
    repo: Repo,
    root: Path,
    targets: Sequence[LintTarget],
    run_targets: Sequence[LintTarget],
    override_options: tuple[str, ...],
) -> BackendResult:
    """Type-check the targets of one project root with mypy --strict."""
    command = mypy_command(repo, root)
    if command is None:
        return not_checked_all(targets, MYPY_TOOL, MYPY_NOT_FOUND)
    package_options = (
        () if root == repo.root else (MYPY_EXPLICIT_PACKAGE_BASES_OPTION,)
    )
    with tempfile.TemporaryDirectory() as scratch:
        argv = [
            *command,
            *MYPY_OPTIONS,
            *MYPY_DISABLED_ERROR_OPTIONS,
            *package_options,
            *override_options,
            MYPY_CACHE_OPTION,
            str(mypy_cache_dir(root)),
            *mypy_shadows(repo, run_targets, Path(scratch)),
            *(repo.absolute(target.path) for target in targets),
        ]
        with heavy_slot():
            done = run_mypy(argv, repo, root, targets)
    if done is None:
        return not_checked_all(targets, MYPY_TOOL, MYPY_FAILED)
    diagnostics = parse_mypy(decode(done.stdout))
    files = targets_by_file(repo, targets)
    found = type_violations(files, root, diagnostics, MYPY_TOOL)
    if mypy_incomplete(
        done.returncode,
        parsed=bool(diagnostics),
        reported=bool(found),
    ):
        reason = failure_reason(done.stderr + done.stdout, MYPY_FAILED)
        return not_checked_all(targets, MYPY_TOOL, reason)
    version = command_version(command, MYPY_TOOL, root)
    return BackendResult(violations=found, tools=(version,))


def mypy_results(repo: Repo, targets: Sequence[LintTarget]) -> BackendResult:
    """Type-check the Python targets with mypy, one run per project root."""
    groups: dict[Path, list[LintTarget]] = {}
    for target in targets:
        groups.setdefault(subproject_root(repo, target), []).append(target)
    override_options = explicit_override_options(repo, targets)
    return merge_results(
        [
            mypy_group_results(repo, root, group, targets, override_options)
            for root, group in groups.items()
        ]
    )


@dataclass(frozen=True, slots=True)
class PythonBackend:
    """Python: ruff check, ruff format, the docstring pass and mypy."""

    name: str = "python"
    languages: frozenset[Language] = frozenset({Language.PYTHON})
    fast: bool = False

    def run(self, repo: Repo, targets: Sequence[LintTarget]) -> BackendResult:
        """Lint Python targets with ruff, the docstring pass and mypy."""
        ruff = ruff_and_docstring_results(repo, targets)
        if self.fast:
            return ruff
        return merge_results([ruff, mypy_results(repo, targets)])

    def fix(
        self,
        repo: Repo,
        snapshots: Sequence[Snapshot],
    ) -> dict[str, str]:
        """Fix Python snapshots with the safe ruff fixes and ruff format."""
        return fix_python(repo, snapshots)


