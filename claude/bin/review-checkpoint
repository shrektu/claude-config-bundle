#!/usr/bin/env bash
usage() {
  cat <<'USAGE'
usage: review-checkpoint save          -> prints a SHA snapshotting the whole working tree, new files included
       review-checkpoint stat <SHA>    -> files changed since that snapshot (new files as additions)
       review-checkpoint diff <SHA>    -> the same plus the patch; files new before the snapshot show only later hunks
       review-checkpoint size          -> change size vs HEAD (staged + unstaged + untracked) for the review gate
save/stat/diff run `git add -A` into a temporary copy of the index, so the real index, the worktree and refs
stay untouched and .gitignore'd files stay out. The snapshot is an unreachable commit, kept until `git gc`
prunes it (2 weeks by default). Older `git stash create` checkpoints keep working.
USAGE
}
set -euo pipefail
CHECKPOINT_MESSAGE=review-checkpoint
cmd=${1:-}

snapshot_index() {
  local real
  real=$(git rev-parse --path-format=absolute --git-path index)
  SNAPSHOT_DIR=$(mktemp -d)
  trap 'rm -rf "$SNAPSHOT_DIR"' EXIT
  export GIT_INDEX_FILE=$SNAPSHOT_DIR/index
  if [ -f "$real" ]; then cp "$real" "$GIT_INDEX_FILE"; fi
  git add -A
}

case "$cmd" in
  save)
    git rev-parse --is-inside-work-tree >/dev/null
    cd "$(git rev-parse --show-toplevel)"
    snapshot_index
    tree=$(git write-tree)
    parent=()
    if head=$(git rev-parse -q --verify HEAD); then parent=(-p "$head"); fi
    GIT_AUTHOR_NAME=$CHECKPOINT_MESSAGE GIT_AUTHOR_EMAIL=$CHECKPOINT_MESSAGE@localhost \
      GIT_COMMITTER_NAME=$CHECKPOINT_MESSAGE GIT_COMMITTER_EMAIL=$CHECKPOINT_MESSAGE@localhost \
      git commit-tree --no-gpg-sign "$tree" "${parent[@]}" -m "$CHECKPOINT_MESSAGE" ;;
  stat|diff)
    sha=${2:-}
    [ -n "$sha" ] || { usage >&2; exit 64; }
    git cat-file -e "$sha^{commit}" 2>/dev/null || { echo "review-checkpoint: unknown checkpoint $sha" >&2; exit 2; }
    cd "$(git rev-parse --show-toplevel)"
    snapshot_index
    echo "## changed since checkpoint ${sha:0:12}"
    git --no-pager diff --cached --stat "$sha"
    if [ "$cmd" = diff ]; then
      echo "## patch"
      git --no-pager diff --cached "$sha"
    fi ;;
  size)
    git rev-parse --is-inside-work-tree >/dev/null
    base=$(git rev-parse --verify -q HEAD || git hash-object -t tree /dev/null)
    numstat=$(mktemp)
    others=$(mktemp)
    trap 'rm -f "$numstat" "$others"' EXIT
    git --no-pager diff --numstat "$base" > "$numstat"
    git ls-files --others --exclude-standard -z > "$others"
    python3 - "$numstat" "$others" <<'PY'
import sys
added = deleted = files = 0
for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
    parts = line.rstrip("\n").split("\t")
    if len(parts) < 3:
        continue
    files += 1
    if parts[0] != "-":
        added += int(parts[0]); deleted += int(parts[1])
untracked = [p for p in open(sys.argv[2], "rb").read().split(b"\0") if p]
for path in untracked:
    try:
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError:
        continue
    if b"\0" not in data:
        added += data.count(b"\n") + (1 if data and not data.endswith(b"\n") else 0)
print(f"files={files + len(untracked)} lines={added + deleted} added={added} deleted={deleted} untracked_files={len(untracked)}")
PY
    ;;
  *) usage >&2; exit 64 ;;
esac
