    "E711": (StaticCategory.COMPARISON, "porównanie z None przez =="),
    "E712": (StaticCategory.COMPARISON, "porównanie z True/False przez =="),
    "N801": (StaticCategory.NAMING, "nazwa klasy niezgodna z PEP 8"),
