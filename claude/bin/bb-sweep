#!/usr/bin/env python3
"""bb-sweep — co w Bitbuckecie czeka na Ciebie.

usage: bb-sweep [--json] [--refresh-repos] [--repos a,b,c] [--deep] [--include-drafts] [SECTION ...]
       bb-sweep resolve REPO PR THREAD [THREAD ...]
       bb-sweep resolve --answered [--repos a,b,c] [--dry-run]
       bb-sweep harvest [--since YYYY-MM-DD] [--repos a,b] [--json] [--all]
       bb-sweep harvest-mark REPO PR THREAD [THREAD ...]
       bb-sweep harvest-done
       bb-sweep static --repo DIR --base REF [--json]

SECTION: mine | review | replies | approve | all   (domyślnie: all)
  mine     PR-y Twojego autorstwa z wątkami bez Twojej odpowiedzi
  review   otwarte cudze PR-y, na których nie oddałeś głosu (nie tylko te z przypisaniem)
  replies  cudze PR-y z moim głosem: wątki, w których ktoś odpowiedział po mnie, komentarze autora w dowolnym wątku i push po moim ostatnim wpisie
  approve  cudze PR-y z moim changes_requested, gdzie wszystkie moje wątki są zamknięte

Wątki bota (CodeRabbit publikuje jako konto Jenkins) są oznaczone [bot]:
po odpowiedzi i poprawce takiego wątku zamyka się go — `resolve --answered`
robi to hurtem dla wątków bota na moich PR-ach, w których ostatni głos jest mój.

Drafty są pomijane — review i odpowiedzi robimy tylko na PR-ach OPEN.
--include-drafts pokazuje je mimo to (sam podgląd, nadal nic nie zapisuje).

Dane z REST API Bitbucketa; poświadczenia z ~/.config/bitbucket/credentials.
Limit API to ~1000 żądań/h, więc skan jest oszczędny: moje PR-y biorą się z jednego zapytania
workspace, a o otwarte PR-y pytane są tylko repozytoria ruszane w ostatnich 120 dni plus te,
gdzie już mnie przypisywano (~/.cache/claude-bb/reviewer-repos.json). `--deep` pyta o wszystkie
repozytoria (wolne, drogie), `--refresh-repos` odświeża listę repozytoriów (7 dni cache),
a stan `resolution` wątków jest cache'owany w ~/.cache/claude-bb/resolved.json.
Skan wszystkich otwartych PR-ów zużywa wyraźnie więcej żądań niż skan samych przypisanych.
Nic nie zapisuje do Bitbucketa — tylko czyta.
"""
from __future__ import annotations

import argparse
import ast
import base64
import contextlib
import dataclasses
import fcntl
import functools
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import tokenize
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from datetime import UTC, date, datetime, timedelta, timezone
from enum import StrEnum
from pathlib import Path, PurePosixPath
from typing import TYPE_CHECKING, Any

from magic_numbers import (
    MagicHit,
    MagicRule,
    python_explained_lines,
    python_magic_hits,
    token_magic_hits,
)
from source_lexer import (
    StaticLanguage,
    Token,
    TokenKind,
    parse_python,
    static_is_test,
    static_language,
    tokenize_source,
)

if TYPE_CHECKING:
    from collections.abc import Callable, Iterator

WORKSPACE = "acme"
API = "https://api.bitbucket.org/2.0/"
CRED_PATH = os.path.expanduser("~/.config/bitbucket/credentials")
CACHE_DIR_ENV = "BB_SWEEP_CACHE_DIR"
CACHE_DIR = os.environ.get(CACHE_DIR_ENV) or str(
    Path("~/.cache/claude-bb").expanduser()
)
REPO_CACHE = os.path.join(CACHE_DIR, "repos.json")
REVIEWER_CACHE = os.path.join(CACHE_DIR, "reviewer-repos.json")
RESOLVED_CACHE = os.path.join(CACHE_DIR, "resolved.json")
REPO_CACHE_MAX_AGE_S = 7 * 24 * 3600
REVIEW_WINDOW_DAYS = 120
BOT_MARKER = "coderabbit-reviewed-pr"
BOT_NICKS = {"jenkins", "coderabbit", "coderabbitai"}
MAX_WORKERS = 10
OPEN_PRS_QUERY = 'state="OPEN"'
ACTIVITY_PAGELEN = 50
SHORT_HASH_LEN = 9


@dataclass(frozen=True)
class PushAfterMe:
    head: str
    pushed_on: str


class ActivityIncomplete(Exception):
    pass


@functools.cache
def auth_header() -> str:
    with open(CRED_PATH) as fh:
        cred = fh.read().strip()
    return "Basic " + base64.b64encode(cred.encode()).decode()


RETRY_CODES = {429, 500, 502, 503, 504}
NO_ACCESS_CODES = {403, 404, 410}
MAX_RETRIES = 6
MAX_BACKOFF_S = 60
REQUESTS_PER_S = 3
_slot_lock = threading.Lock()
_next_slot = [0.0]


def throttle() -> None:
    """Globalny limiter — Bitbucket odpowiada 429 na zrywy równoległych żądań."""
    with _slot_lock:
        now = time.monotonic()
        slot = max(now, _next_slot[0])
        _next_slot[0] = slot + 1 / REQUESTS_PER_S
    if slot > now:
        time.sleep(slot - now)


def get(url: str) -> dict:
    if not url.startswith("http"):
        url = API + url
    req = urllib.request.Request(url, headers={"Authorization": auth_header()})
    for attempt in range(MAX_RETRIES):
        throttle()
        try:
            with urllib.request.urlopen(req) as resp:
                return json.load(resp)
        except urllib.error.HTTPError as err:
            if err.code not in RETRY_CODES or attempt == MAX_RETRIES - 1:
                raise
            wait = err.headers.get("Retry-After")
            time.sleep(
                float(wait)
                if wait and wait.isdigit()
                else min(MAX_BACKOFF_S, 2**attempt)
            )
        except urllib.error.URLError:
            if attempt == MAX_RETRIES - 1:
                raise
            time.sleep(min(MAX_BACKOFF_S, 2**attempt))
    raise RuntimeError("nieosiągalne")


def post_empty(url: str) -> dict:
    """Puste POST-y Bitbucketa (resolve, approve) wywalają się z Content-Type."""
    req = urllib.request.Request(
        API + url,
        data=b"",
        headers={"Authorization": auth_header()},
        method="POST",
    )
    throttle()
    with urllib.request.urlopen(req) as resp:
        return json.load(resp)


def pages(url: str):
    while url:
        data = get(url)
        yield from data.get("values", [])
        url = data.get("next")


def me() -> dict:
    return get("user")


def load_cache(path: str, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def save_cache(path: str, data) -> None:
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(path, "w") as fh:
        json.dump(data, fh)


def repo_index(refresh: bool) -> dict[str, str]:
    """slug -> updated_on; lista repozytoriów zmienia się rzadko, cache na 7 dni."""
    cached = load_cache(REPO_CACHE, None)
    fresh = (
        not refresh
        and isinstance(cached, dict)
        and cached.get("updated")
        and time.time() - os.path.getmtime(REPO_CACHE) < REPO_CACHE_MAX_AGE_S
    )
    if fresh:
        return cached["updated"]
    index = {
        r["slug"]: r.get("updated_on") or ""
        for r in pages(
            f"repositories/{WORKSPACE}?pagelen=100&fields=values.slug,values.updated_on,next"
        )
    }
    save_cache(REPO_CACHE, {"updated": index})
    return index


def candidate_repos(index: dict[str, str], deep: bool) -> list[str]:
    """Pytamy o reviewera tylko repozytoria żywe albo takie, gdzie już mnie przypisano."""
    if deep:
        return sorted(index)
    cutoff = (
        datetime.now(timezone.utc) - timedelta(days=REVIEW_WINDOW_DAYS)
    ).isoformat()
    recent = {slug for slug, updated in index.items() if updated >= cutoff}
    return sorted(recent | set(load_cache(REVIEWER_CACHE, [])))


PR_FIELDS = ",".join(
    [
        "values.id",
        "values.title",
        "values.draft",
        "values.updated_on",
        "values.comment_count",
        "values.author.uuid",
        "values.author.display_name",
        "values.source.branch.name",
        "values.source.commit.hash",
        "values.destination.branch.name",
        "values.participants",
        "values.reviewers.uuid",
        "values.links.html.href",
        "next",
    ]
)
MY_PR_FIELDS = PR_FIELDS + ",values.destination.repository.full_name"


def my_open_prs(uuid: str) -> list[tuple[str, dict]]:
    """Wszystkie moje otwarte PR-y w workspace jednym zapytaniem, bez skanu repozytoriów."""
    url = (
        f"workspaces/{WORKSPACE}/pullrequests/{urllib.parse.quote(uuid)}"
        f"?state=OPEN&pagelen=50&fields={MY_PR_FIELDS}"
    )
    out = []
    for pr in pages(url):
        full_name = pr["destination"]["repository"]["full_name"]
        out.append((full_name.split("/")[-1], pr))
    return out


def open_prs(repo: str, query: str) -> list[dict]:
    q = urllib.parse.quote(query)
    try:
        return list(
            pages(
                f"repositories/{WORKSPACE}/{repo}/pullrequests"
                f"?q={q}&pagelen=50&fields={PR_FIELDS}"
            )
        )
    except urllib.error.HTTPError as err:
        if err.code in NO_ACCESS_CODES:
            return []
        raise


def comments(repo: str, pr_id: int) -> list[dict] | None:
    """None = nie udało się pobrać; pusta lista = PR bez komentarzy."""
    try:
        return [
            c
            for c in pages(
                f"repositories/{WORKSPACE}/{repo}/pullrequests/{pr_id}"
                f"/comments?pagelen=100"
            )
            if not c.get("deleted")
        ]
    except (urllib.error.HTTPError, urllib.error.URLError):
        return None


RESOLVED_IDS: set[int] = set()


def is_resolved(repo: str, pr_id: int, comment_id: int) -> bool | None:
    """Listing nie zwraca `resolution` — trzeba dobić pojedynczym GET-em; None = błąd."""
    if comment_id in RESOLVED_IDS:
        return True
    try:
        c = get(
            f"repositories/{WORKSPACE}/{repo}/pullrequests/{pr_id}/comments/{comment_id}"
        )
    except (urllib.error.HTTPError, urllib.error.URLError):
        return None
    if c.get("resolution"):
        RESOLVED_IDS.add(comment_id)
        return True
    return False


def is_bot(user: dict) -> bool:
    name = (user.get("nickname") or user.get("display_name") or "").strip().lower()
    return name in BOT_NICKS


def threads(items: list[dict]) -> dict[int, list[dict]]:
    by_id = {c["id"]: c for c in items}

    def root(c: dict) -> int:
        seen: set[int] = set()
        while c.get("parent") and c["parent"]["id"] in by_id and c["id"] not in seen:
            seen.add(c["id"])
            c = by_id[c["parent"]["id"]]
        return c["id"]

    out: dict[int, list[dict]] = {}
    for c in items:
        out.setdefault(root(c), []).append(c)
    for chain in out.values():
        chain.sort(key=lambda c: c["created_on"])
    return out


def location(comment: dict) -> str:
    inline = comment.get("inline") or {}
    if not inline:
        return "ogólny"
    line = inline.get("to") or inline.get("from") or ""
    return f"{inline.get('path')}:{line}"


def excerpt(comment: dict, limit: int = 160) -> str:
    return " ".join(comment["content"]["raw"].split())[:limit]


def my_state(pr: dict, uuid: str) -> str | None:
    for p in pr.get("participants", []):
        if p["user"]["uuid"] == uuid:
            return p.get("state")
    return None


def parse_ts(value: str) -> datetime:
    return datetime.fromisoformat(value)


def my_last_entry(
    items: list[dict], uuid: str, participated_on: str | None
) -> datetime | None:
    entries = [
        parse_ts(comment["created_on"])
        for comment in items
        if comment["user"]["uuid"] == uuid
    ]
    if participated_on is not None:
        entries.append(parse_ts(participated_on))
    return max(entries) if entries else None


def author_threads_after(
    items: list[dict], author_uuid: str, uuid: str, since: datetime
) -> list[dict]:
    out: list[dict] = []
    for rid, chain in threads(items).items():
        if BOT_MARKER in chain[0]["content"]["raw"]:
            continue
        if any(comment["user"]["uuid"] == uuid for comment in chain):
            continue
        qualifying = [
            comment
            for comment in chain
            if comment["user"]["uuid"] == author_uuid
            and not is_bot(comment["user"])
            and parse_ts(comment["created_on"]) > since
        ]
        if not qualifying:
            continue
        newest = qualifying[-1]
        out.append(
            {
                "thread": rid,
                "bot": False,
                "where": location(chain[0]),
                "last_by": newest["user"]["display_name"],
                "last_on": newest["created_on"][:16],
                "excerpt": excerpt(newest),
                "size": len(chain),
                "outside": True,
            }
        )
    return out


def push_after(repo: str, pr_id: int, head_hash: str, since: datetime) -> PushAfterMe | None:
    updates: list[dict] = []
    baseline: str | None = None
    for activity in pages(
        f"repositories/{WORKSPACE}/{repo}/pullrequests/{pr_id}/activity"
        f"?pagelen={ACTIVITY_PAGELEN}"
    ):
        update = activity.get("update")
        if update is None:
            continue
        try:
            update_date = update["date"]
            update_hash = update["source"]["commit"]["hash"]
        except KeyError:
            raise ActivityIncomplete from None
        if parse_ts(update_date) <= since:
            baseline = update_hash
            break
        updates.append(update)
    if baseline is None:
        raise ActivityIncomplete
    if head_hash == baseline:
        return None
    newest_push = next(
        (
            update
            for update in updates
            if update["source"]["commit"]["hash"] != baseline
        ),
        None,
    )
    if newest_push is None:
        raise ActivityIncomplete
    return PushAfterMe(
        head=head_hash[:SHORT_HASH_LEN],
        pushed_on=newest_push["date"],
    )


def assigned_to_me(pr: dict, uuid: str) -> bool:
    return any(reviewer.get("uuid") == uuid for reviewer in pr.get("reviewers", []))


def collect(
    repos: list[str],
    uuid: str,
    include_drafts: bool = False,
    need_review: bool = True,
) -> dict:
    def wanted(pr: dict) -> bool:
        return include_drafts or not pr.get("draft")

    def scan(repo: str) -> tuple[str, list[dict], bool]:
        try:
            return repo, open_prs(repo, OPEN_PRS_QUERY), True
        except (urllib.error.HTTPError, urllib.error.URLError):
            return repo, [], False

    mine = [(repo, pr) for repo, pr in my_open_prs(uuid) if wanted(pr)]
    seen = {(repo, pr["id"]) for repo, pr in mine}
    review: list[tuple[str, dict]] = []
    unreachable: list[str] = []
    if need_review:
        assigned_repos: set[str] = set()
        with ThreadPoolExecutor(max_workers=MAX_WORKERS) as pool:
            for repo, r, ok in pool.map(scan, repos):
                if not ok:
                    unreachable.append(f"{repo} (lista PR-ów)")
                if any(assigned_to_me(pr, uuid) for pr in r):
                    assigned_repos.add(repo)
                review += [
                    (repo, pr)
                    for pr in r
                    if wanted(pr) and (repo, pr["id"]) not in seen
                ]
        save_cache(REVIEWER_CACHE, sorted(assigned_repos))

    def with_comments(entry: tuple[str, dict]) -> tuple[str, dict, list[dict] | None]:
        repo, pr = entry
        return repo, pr, comments(repo, pr["id"]) if pr["comment_count"] else []

    result = {"mine": [], "review": [], "replies": [], "approve": [], "degraded": unreachable}
    with ThreadPoolExecutor(max_workers=8) as pool:
        for repo, pr, items in pool.map(with_comments, mine + review):
            authored_by_me = pr["author"]["uuid"] == uuid
            waiting = []
            answered_me = []
            outside = []
            push = None
            my_open = 0
            degraded = items is None
            for rid, chain in threads(items or []).items():
                if BOT_MARKER in chain[0]["content"]["raw"]:
                    continue
                last = chain[-1]
                i_spoke = any(c["user"]["uuid"] == uuid for c in chain)
                mine_to_close = not authored_by_me and i_spoke
                if last["user"]["uuid"] == uuid and not mine_to_close:
                    continue
                resolved = is_resolved(repo, pr["id"], rid)
                if resolved is None:
                    degraded = True
                elif resolved:
                    continue
                if mine_to_close:
                    my_open += 1
                if last["user"]["uuid"] == uuid:
                    continue
                row = {
                    "thread": rid,
                    "bot": is_bot(chain[0]["user"]),
                    "where": location(chain[0]),
                    "last_by": last["user"]["display_name"],
                    "last_on": last["created_on"][:16],
                    "excerpt": excerpt(last),
                    "size": len(chain),
                }
                if authored_by_me:
                    waiting.append(row)
                elif i_spoke:
                    answered_me.append(row)
            state = my_state(pr, uuid)
            if not authored_by_me and state is not None and items is not None:
                participated_on = next(
                    (
                        participant.get("participated_on")
                        for participant in pr.get("participants", [])
                        if participant["user"]["uuid"] == uuid
                    ),
                    None,
                )
                since = my_last_entry(items, uuid, participated_on)
                if since is not None:
                    outside = author_threads_after(
                        items, pr["author"]["uuid"], uuid, since
                    )
                    try:
                        push = push_after(
                            repo, pr["id"], pr["source"]["commit"]["hash"], since
                        )
                    except (
                        urllib.error.HTTPError,
                        urllib.error.URLError,
                        ActivityIncomplete,
                    ):
                        degraded = True
            row = {
                "repo": repo,
                "id": pr["id"],
                "title": pr["title"],
                "author": pr["author"]["display_name"],
                "branch": pr["source"]["branch"]["name"],
                "head": pr["source"]["commit"]["hash"][:9],
                "draft": bool(pr.get("draft")),
                "updated": pr["updated_on"][:16],
                "url": pr["links"]["html"]["href"],
                "my_state": state,
                "my_open": my_open,
                "degraded": degraded,
                "threads": waiting or answered_me,
                "pushed_after_me": dataclasses.asdict(push) if push else None,
            }
            if authored_by_me:
                if waiting:
                    result["mine"].append(row)
            else:
                if answered_me or outside or push:
                    result["replies"].append(
                        dict(row, threads=answered_me + outside)
                    )
                if row["my_state"] is None:
                    result["review"].append(dict(row, threads=[]))
                elif row["my_state"] == "changes_requested" and not my_open and not degraded:
                    result["approve"].append(dict(row, threads=[]))
            if degraded:
                result["degraded"].append(f"{repo}#{pr['id']}")
    for key in ("mine", "review", "replies", "approve"):
        result[key].sort(key=lambda r: r["updated"], reverse=True)
    result["degraded"].sort()
    return result


def render(result: dict, sections: set[str]) -> None:
    def header(title: str, rows: list[dict]) -> None:
        print(f"\n{'=' * 72}\n{title}  ({len(rows)})\n{'=' * 72}")

    if "mine" in sections:
        rows = result["mine"]
        header("MOJE PR-Y — wątki bez mojej odpowiedzi", rows)
        for r in rows:
            print(f"\n  {r['repo']}#{r['id']}  {r['title'][:58]}")
            print(f"    {r['url']}")
            for t in r["threads"]:
                tag = " [bot]" if t.get("bot") else ""
                print(
                    f"    [{t['thread']}]{tag} {t['where']}  "
                    f"— {t['last_by']} {t['last_on']}"
                )
                print(f"        {t['excerpt']}")
        if any(t.get("bot") for r in rows for t in r["threads"]):
            print("\n  [bot] = CodeRabbit — po odpowiedzi i poprawce zamknij wątek:")
            print("        bb-sweep resolve <repo> <pr> <id>   |   bb-sweep resolve --answered")
        if not rows:
            print("\n  (nic nie czeka)")

    if "review" in sections:
        rows = result["review"]
        header("DO REVIEW — otwarte PR-y bez mojego głosu", rows)
        for r in rows:
            draft = " [DRAFT]" if r["draft"] else ""
            print(
                f"  {r['repo']}#{r['id']}{draft}  {r['author']:<18} "
                f"{r['head']}  {r['title'][:50]}"
            )
            print(f"    {r['url']}")
        if not rows:
            print("\n  (nic nie czeka)")

    if "replies" in sections:
        rows = result["replies"]
        header("CUDZE PR-Y — ktoś odpowiedział albo pushnął po mnie", rows)
        for r in rows:
            print(
                f"\n  {r['repo']}#{r['id']}  {r['title'][:58]}  "
                f"[mój głos: {r['my_state']}, moje otwarte wątki: {r['my_open']}]"
            )
            print(f"    {r['url']}")
            if r["pushed_after_me"]:
                push = r["pushed_after_me"]
                print(
                    "    nowy push po moim ostatnim wpisie: "
                    f"{push['head']} {push['pushed_on'][:16]}"
                )
            for t in r["threads"]:
                tag = " [bot]" if t.get("bot") else ""
                if t.get("outside"):
                    tag += " [poza moimi wątkami]"
                print(
                    f"    [{t['thread']}]{tag} {t['where']}  "
                    f"— {t['last_by']} {t['last_on']}"
                )
                print(f"        {t['excerpt']}")
        if not rows:
            print("\n  (nic nie czeka)")

    if "approve" in sections:
        rows = result["approve"]
        header("DO APPROVE — moje wątki zamknięte, głos wciąż changes_requested", rows)
        for r in rows:
            print(
                f"  {r['repo']}#{r['id']}  {r['author']:<18} {r['head']}  "
                f"{r['title'][:50]}"
            )
            print(f"    {r['url']}")
        if not rows:
            print("\n  (nic nie czeka)")
    broken = result.get("degraded") or []
    if broken:
        print(
            f"\n  UWAGA: {len(broken)} PR-ów nie dało się w pełni sprawdzić "
            f"(API zwróciło błąd): {', '.join(broken[:10])}"
            f"{' …' if len(broken) > 10 else ''}"
        )
        print("  Te PR-y są pominięte w sekcji approve — powtórz skan przed głosowaniem.")
    print()


def resolve_thread(repo: str, pr_id: int, thread_id: int) -> str:
    url = (
        f"repositories/{WORKSPACE}/{repo}/pullrequests/{pr_id}"
        f"/comments/{thread_id}/resolve"
    )
    try:
        post_empty(url)
    except urllib.error.HTTPError as err:
        return f"BLAD {err.code}"
    return "zamkniety"


def answered_bot_threads(repos: list[str] | None, uuid: str) -> list[dict]:
    prs = [
        (repo, pr)
        for repo, pr in my_open_prs(uuid)
        if not pr.get("draft") and (repos is None or repo in repos)
    ]

    def scan_pr(entry: tuple[str, dict]) -> list[dict]:
        repo, pr = entry
        items = comments(repo, pr["id"]) if pr["comment_count"] else []
        if items is None:
            print(f"POMINIETO {repo}#{pr['id']}: nie udalo sie pobrac komentarzy", file=sys.stderr)
            return []
        out = []
        for rid, chain in threads(items).items():
            root = chain[0]
            if not is_bot(root["user"]) or BOT_MARKER in root["content"]["raw"]:
                continue
            if chain[-1]["user"]["uuid"] != uuid:
                continue
            if is_resolved(repo, pr["id"], rid) is not False:
                continue
            out.append(
                {
                    "repo": repo,
                    "pr": pr["id"],
                    "thread": rid,
                    "where": location(root),
                    "excerpt": excerpt(root, 90),
                }
            )
        return out

    rows: list[dict] = []
    with ThreadPoolExecutor(max_workers=12) as pool:
        for got in pool.map(scan_pr, prs):
            rows += got
    return sorted(rows, key=lambda r: (r["repo"], r["pr"], r["thread"]))


def cmd_resolve(argv: list[str]) -> int:
    dry = "--dry-run" in argv
    rest = [a for a in argv if not a.startswith("--")]
    if "--answered" in argv:
        only = None
        for i, a in enumerate(argv):
            if a == "--repos" and i + 1 < len(argv):
                only = [s for s in argv[i + 1].split(",") if s]
                rest = [a for a in rest if a not in only and a != argv[i + 1]]
        user = me()
        rows = answered_bot_threads(only, user["uuid"])
        if not rows:
            print("brak wątków CodeRabbita z moją odpowiedzią do zamknięcia")
            return 0
        for r in rows:
            state = "do zamkniecia" if dry else resolve_thread(r["repo"], r["pr"], r["thread"])
            print(f"{r['repo']}#{r['pr']} [{r['thread']}] {r['where']}  {state}")
            print(f"    {r['excerpt']}")
        return 0
    if len(rest) < 3:
        print("użycie: bb-sweep resolve REPO PR THREAD [THREAD ...]", file=sys.stderr)
        return 2
    repo, pr_id = rest[0], int(rest[1])
    for raw in rest[2:]:
        state = "do zamkniecia" if dry else resolve_thread(repo, pr_id, int(raw))
        print(f"{repo}#{pr_id} [{raw}] {state}")
    return 0


HARVEST_STATE_NAME = "harvested.json"
HARVEST_STATE_VERSION = 1
HARVEST_DEFAULT_DAYS = 180
HARVEST_PAGELEN = 50
HARVEST_ROOT_LIMIT = 600
HARVEST_REPLY_LIMIT = 300
HARVEST_STATES = ("OPEN", "MERGED")
HARVEST_SORT = "-updated_on"
HARVEST_PR_FIELD_NAMES = (
    "values.id",
    "values.title",
    "values.updated_on",
    "values.destination.repository.full_name",
    "values.links.html.href",
    "next",
)
HARVEST_PR_FIELDS = ",".join(HARVEST_PR_FIELD_NAMES)
HARVEST_TEMP_SUFFIX = ".tmp"
HARVEST_ENCODING = "utf-8"
HARVEST_USAGE_EXIT = 2
HARVEST_OK_EXIT = 0
HARVEST_MARK_USAGE = (
    "użycie: bb-sweep harvest-mark REPO PR THREAD [THREAD ...]"
)
HARVEST_MARK_MIN_ARGS = 3
HARVEST_DONE_USAGE = "użycie: bb-sweep harvest-done"
HARVEST_LOCK_SUFFIX = ".lock"
HARVEST_NO_CUTOFF = "brak"
HARVEST_TIME_PREFIX = 16


class HarvestStateCorruptError(Exception):
    """The harvest state file exists but cannot be parsed."""


@dataclass
class HarvestState:
    """Refs of review threads already turned into habits."""

    last_harvest: str | None = None
    refs: list[str] = dataclasses.field(default_factory=list)


@dataclass(frozen=True)
class HarvestedThread:
    """One review thread by someone else on one of my PRs."""

    repo: str
    pr: int
    pr_title: str
    pr_url: str
    thread: int
    ref: str
    author: str
    bot: bool
    created_on: str
    where: str
    text: str
    my_replies: list[str]
    resolved: bool | None


def harvest_today() -> date:
    """Return today's local date."""
    return datetime.now(UTC).astimezone().date()


def harvest_state_path() -> Path:
    """Return the harvest state file inside the cache directory."""
    return Path(CACHE_DIR) / HARVEST_STATE_NAME


def harvest_ref(repo: str, pr_id: int, thread_id: int) -> str:
    """Return the ref that names one review thread."""
    return f"{repo}#{pr_id}/{thread_id}"


def read_harvest_state() -> HarvestState:
    """Read the state file; a missing one is empty, a broken one raises."""
    try:
        text = harvest_state_path().read_text(encoding=HARVEST_ENCODING)
    except FileNotFoundError:
        return HarvestState()
    except (OSError, UnicodeDecodeError) as err:
        raise HarvestStateCorruptError(str(err)) from err
    try:
        record = json.loads(text)
    except ValueError as err:
        raise HarvestStateCorruptError(str(err)) from err
    if not isinstance(record, dict):
        raise HarvestStateCorruptError(HARVEST_STATE_NAME)
    last = record.get("last_harvest")
    refs = record.get("refs", [])
    valid_refs = isinstance(refs, list) and all(
        isinstance(ref, str) for ref in refs
    )
    if not valid_refs or not (last is None or isinstance(last, str)):
        raise HarvestStateCorruptError(HARVEST_STATE_NAME)
    return HarvestState(last_harvest=last, refs=refs)


def write_harvest_state(state: HarvestState) -> None:
    """Write the state file atomically (temp file and os.replace)."""
    Path(CACHE_DIR).mkdir(parents=True, exist_ok=True)
    record = {
        "version": HARVEST_STATE_VERSION,
        "last_harvest": state.last_harvest,
        "refs": state.refs,
    }
    with tempfile.NamedTemporaryFile(
        "w",
        encoding=HARVEST_ENCODING,
        dir=CACHE_DIR,
        prefix=HARVEST_STATE_NAME,
        suffix=HARVEST_TEMP_SUFFIX,
        delete=False,
    ) as fh:
        json.dump(record, fh, indent=1)
        temp_path = Path(fh.name)
    temp_path.replace(harvest_state_path())


def harvest_since(
    given: date | None, state: HarvestState, today: date
) -> date:
    """Pick --since, else the last harvest, else today minus 180 days."""
    if given is not None:
        return given
    if state.last_harvest:
        try:
            return date.fromisoformat(state.last_harvest)
        except ValueError:
            pass
    return today - timedelta(days=HARVEST_DEFAULT_DAYS)


def my_recent_prs(uuid: str, since: date) -> list[tuple[str, dict]]:
    """My OPEN and MERGED PRs updated on or after since, newest first."""
    states = "&".join(f"state={state}" for state in HARVEST_STATES)
    url = (
        f"workspaces/{WORKSPACE}/pullrequests/{urllib.parse.quote(uuid)}"
        f"?{states}&sort={HARVEST_SORT}&pagelen={HARVEST_PAGELEN}"
        f"&fields={HARVEST_PR_FIELDS}"
    )
    out = []
    for pr in pages(url):
        if parse_ts(pr["updated_on"]).date() < since:
            break
        full_name = pr["destination"]["repository"]["full_name"]
        out.append((full_name.split("/")[-1], pr))
    return out


def harvest_pr(
    repo: str, pr: dict, uuid: str, marked: set[str]
) -> list[HarvestedThread] | None:
    """Collect review threads of others on one PR; None = fetch failed."""
    items = comments(repo, pr["id"])
    if items is None:
        return None
    out = []
    for rid, chain in threads(items).items():
        root = chain[0]
        if root["user"].get("uuid") == uuid:
            continue
        ref = harvest_ref(repo, pr["id"], rid)
        if ref in marked:
            continue
        out.append(
            HarvestedThread(
                repo=repo,
                pr=pr["id"],
                pr_title=pr.get("title") or "",
                pr_url=pr.get("links", {}).get("html", {}).get("href", ""),
                thread=rid,
                ref=ref,
                author=root["user"].get("display_name") or "",
                bot=is_bot(root["user"]),
                created_on=root["created_on"],
                where=location(root),
                text=excerpt(root, HARVEST_ROOT_LIMIT),
                my_replies=[
                    excerpt(reply, HARVEST_REPLY_LIMIT)
                    for reply in chain[1:]
                    if reply["user"].get("uuid") == uuid
                ],
                resolved=is_resolved(repo, pr["id"], rid),
            )
        )
    return out


def harvest_threads(
    prs: list[tuple[str, dict]], uuid: str, marked: set[str]
) -> tuple[list[HarvestedThread], list[str]]:
    """Harvest every PR; return the threads and the PRs that failed."""

    def scan(entry: tuple[str, dict]) -> list[HarvestedThread] | None:
        """Harvest one PR."""
        repo, pr = entry
        return harvest_pr(repo, pr, uuid, marked)

    rows: list[HarvestedThread] = []
    broken: list[str] = []
    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as pool:
        for (repo, pr), got in zip(prs, pool.map(scan, prs), strict=True):
            if got is None:
                broken.append(f"{repo}#{pr['id']}")
            else:
                rows += got
    return rows, broken


def render_harvest(rows: list[HarvestedThread], since: date) -> None:
    """Print the harvested threads grouped per PR."""
    print(f"bb-sweep harvest — od {since.isoformat()} — {len(rows)} wątków")
    current = None
    for row in rows:
        if (row.repo, row.pr) != current:
            current = (row.repo, row.pr)
            print(f"\n{row.repo}#{row.pr}  {row.pr_title}")
            print(f"  {row.pr_url}")
        tags = " [bot]" if row.bot else ""
        if row.resolved:
            tags += " [resolved]"
        print(
            f"  [{row.thread}]{tags} {row.where}  — {row.author} "
            f"{row.created_on[:HARVEST_TIME_PREFIX]}"
        )
        print(f"      {row.text}")
        for reply in row.my_replies:
            print(f"      > ja: {reply}")
    if not rows:
        print("\n  (nic nowego)")


def harvest_parser() -> argparse.ArgumentParser:
    """Build the parser of the harvest subcommand."""
    parser = argparse.ArgumentParser(prog="bb-sweep harvest")
    parser.add_argument("--since", type=date.fromisoformat)
    parser.add_argument("--repos")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--all", action="store_true")
    return parser


def cmd_harvest(argv: list[str]) -> int:
    """List review threads of others on my PRs not yet turned into habits."""
    args = harvest_parser().parse_args(argv)
    try:
        state = read_harvest_state()
    except HarvestStateCorruptError:
        state = HarvestState()
    since = harvest_since(args.since, state, harvest_today())
    only = {s for s in (args.repos or "").split(",") if s}
    user = me()
    prs = [
        (repo, pr)
        for repo, pr in my_recent_prs(user["uuid"], since)
        if not only or repo in only
    ]
    marked = set() if args.all else set(state.refs)
    rows, broken = harvest_threads(prs, user["uuid"], marked)
    if args.json:
        records = [dataclasses.asdict(row) for row in rows]
        print(json.dumps(records, ensure_ascii=False, indent=1))
    else:
        render_harvest(rows, since)
    if broken:
        print(
            f"\n  UWAGA: {len(broken)} PR-ów nie dało się sprawdzić "
            f"(API zwróciło błąd): {', '.join(broken)}",
            file=sys.stderr if args.json else sys.stdout,
        )
    return HARVEST_OK_EXIT


@contextlib.contextmanager
def harvest_state_lock() -> Iterator[None]:
    """Hold an exclusive flock on the sidecar lock of the state file."""
    path = harvest_state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = path.with_name(path.name + HARVEST_LOCK_SUFFIX)
    with lock_path.open("a", encoding=HARVEST_ENCODING) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def update_harvest_state(change: Callable[[HarvestState], None]) -> bool:
    """Read, change and write the state under the lock; False if corrupt."""
    with harvest_state_lock():
        try:
            state = read_harvest_state()
        except HarvestStateCorruptError as err:
            print(
                f"uszkodzony {harvest_state_path()}: {err} — nie nadpisuję",
                file=sys.stderr,
            )
            return False
        change(state)
        write_harvest_state(state)
    return True


def cmd_harvest_mark(argv: list[str]) -> int:
    """Record review threads as processed; the cutoff stays unchanged."""
    if len(argv) < HARVEST_MARK_MIN_ARGS:
        print(HARVEST_MARK_USAGE, file=sys.stderr)
        return HARVEST_USAGE_EXIT
    repo, *numbers = argv
    try:
        pr_id, *thread_ids = [int(number) for number in numbers]
    except ValueError:
        print(HARVEST_MARK_USAGE, file=sys.stderr)
        return HARVEST_USAGE_EXIT
    wanted = dict.fromkeys(
        harvest_ref(repo, pr_id, thread_id) for thread_id in thread_ids
    )
    new: list[str] = []

    def add_refs(state: HarvestState) -> None:
        """Add the refs that are not recorded yet."""
        known = set(state.refs)
        new.extend(ref for ref in wanted if ref not in known)
        state.refs = sorted(known | set(new))

    if not update_harvest_state(add_refs):
        return HARVEST_USAGE_EXIT
    print(f"oznaczono {len(new)} nowych wątków")
    return HARVEST_OK_EXIT


def cmd_harvest_done(argv: list[str]) -> int:
    """Move the default harvest cutoff to today once every thread is marked."""
    if argv:
        print(HARVEST_DONE_USAGE, file=sys.stderr)
        return HARVEST_USAGE_EXIT
    today = harvest_today().isoformat()
    previous: list[str | None] = []

    def move_cutoff(state: HarvestState) -> None:
        """Set last_harvest to today, remembering the old value."""
        previous.append(state.last_harvest)
        state.last_harvest = today

    if not update_harvest_state(move_cutoff):
        return HARVEST_USAGE_EXIT
    old = previous[0] or HARVEST_NO_CUTOFF
    print(f"last_harvest: {old} -> {today}")
    return HARVEST_OK_EXIT


