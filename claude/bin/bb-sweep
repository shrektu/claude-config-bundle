class StaticUsageError(Exception):
    """The static check cannot run on the given repository or base."""


class StaticCategory(StrEnum):
    """The kinds of mechanical review candidates."""

    MAGIC_NUMBER = "magic-number"
    LITERAL_ATTR = "literal-attr"
    COMMENTED_CODE = "commented-code"
    EMPTY_CATCH = "empty-catch"
    DUPLICATION = "duplication"
    SWALLOWED_EXCEPTION = "swallowed-exception"
    BARE_EXCEPT = "bare-except"
    MUTABLE_DEFAULT = "mutable-default"
    COMPARISON = "comparison"
    NAMING = "naming"
    UNUSED_VARIABLE = "unused-variable"


STATIC_RUFF_LABELS = {
    STATIC_RULE_RUFF_MAGIC: (
        StaticCategory.MAGIC_NUMBER,
        STATIC_MAGIC_LABELS[MagicRule.COMPARISON],
    ),
    "ERA001": (StaticCategory.COMMENTED_CODE, "zakomentowany kod"),
    "BLE001": (
        StaticCategory.SWALLOWED_EXCEPTION,
        "zbyt szerokie except Exception",
    ),
    "S110": (StaticCategory.SWALLOWED_EXCEPTION, "połknięty wyjątek (pass)"),
    "S112": (
