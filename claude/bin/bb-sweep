    """One fragment of a jscpd clone."""

    path: str
    start: int
    end: int


def static_git(repo: Path, *args: str) -> str:
    """Run git in the repository and return its stdout."""
    try:
        done = subprocess.run(
            ["git", "-C", str(repo), *args],
            capture_output=True,
            check=False,
        )
    except OSError as err:
        message = f"git unavailable: {err}"
        raise StaticUsageError(message) from None
    output = done.stdout.decode(STATIC_ENCODING, errors="replace")
    if done.returncode != 0:
        message = done.stderr.decode(STATIC_ENCODING, errors="replace")
        raise StaticUsageError(message.strip() or "git failed")
    return output


def static_merge_base(repo: Path, base: str) -> str:
    """Return the merge-base of the base ref and HEAD."""
    try:
        return static_git(repo, "merge-base", base, "HEAD").strip()
    except StaticUsageError as err:
        message = f"cannot resolve --base {base}: {err}"
        raise StaticUsageError(message) from None


def hunk_extent(match: re.Match[str]) -> tuple[int, int, int]:
    """Return the old count, new count and new start of a hunk header."""
    old = 1 if match.group(1) is None else int(match.group(1))
    new = 1 if match.group(3) is None else int(match.group(3))
    return old, new, int(match.group(2))


def unquote_git_path(quoted: str) -> str:
    """Decode a C-style quoted path as git prints it."""
    raw = quoted[1:-1].encode(STATIC_ENCODING, errors="surrogateescape")

    def decode(match: re.Match[bytes]) -> bytes:
        """Turn one escape sequence into its byte."""
        octal, char = match.groups()
        if octal:
            return bytes([int(octal, STATIC_OCTAL_BASE)])
        return STATIC_GIT_ESCAPES.get(char, char)

    return STATIC_GIT_ESCAPE.sub(decode, raw).decode(
        STATIC_ENCODING, errors="replace"
    )


def new_side_path(header: str) -> str | None:
    """Return the new-side path of a +++ header, None when deleted."""
    name = header[len(STATIC_NEW_SIDE_HEADER) :].split("\t", 1)[0]
    if name.startswith('"'):
        name = unquote_git_path(name)
    if name == STATIC_DEV_NULL:
        return None
    return name.removeprefix(STATIC_NEW_SIDE_PREFIX)


def parse_added_lines(patch: str) -> dict[str, frozenset[int]]:
    """Return the new-side lines each file adds in a -U0 patch."""
    added: dict[str, set[int]] = {}
    path: str | None = None
    old_left = new_left = new_line = 0
    for text in patch.split("\n"):
        if old_left or new_left:
            if text.startswith("+") and path is not None:
                added.setdefault(path, set()).add(new_line)
            old_left, new_left, new_line = advance_hunk(
                text, old_left, new_left, new_line
            )
        elif text.startswith(STATIC_FILE_HEADER):
            path = None
        elif text.startswith(STATIC_NEW_SIDE_HEADER):
            path = new_side_path(text)
        elif match := STATIC_HUNK.match(text):
            old_left, new_left, new_line = hunk_extent(match)
    return {name: frozenset(lines) for name, lines in added.items() if lines}


def advance_hunk(
    text: str, old_left: int, new_left: int, new_line: int
) -> tuple[int, int, int]:
    """Move the hunk counters past one body line."""
    if text.startswith("-"):
        return old_left - 1, new_left, new_line
    if text.startswith("+"):
        return old_left, new_left - 1, new_line + 1
    if text.startswith(" "):
        return old_left - 1, new_left - 1, new_line + 1
    return old_left, new_left, new_line


def static_is_skipped(path: str) -> bool:
    """Tell whether a path is generated or vendored."""
    pure = PurePosixPath(path)
    if STATIC_SKIPPED_DIRS & set(pure.parts[:-1]):
        return True
    return pure.name.endswith(STATIC_SKIPPED_SUFFIXES)


def head_text(repo: Path, path: str) -> str | None:
    """Return the text of a file at HEAD, None when unreadable."""
    try:
        done = subprocess.run(
            ["git", "-C", str(repo), "cat-file", "blob", f"HEAD:{path}"],
            capture_output=True,
            check=False,
        )
    except OSError:
        return None
    if done.returncode != 0:
        return None
    text = done.stdout.decode(STATIC_ENCODING, errors="replace")
    return text.replace("\r\n", "\n")


def load_sources(
    repo: Path, added: dict[str, frozenset[int]]
) -> tuple[list[StaticSource], list[str]]:
    """Read the changed files at HEAD, listing the unreadable ones."""
    sources: list[StaticSource] = []
    not_checked: list[str] = []
    for path, lines in sorted(added.items()):
        language = static_language(path)
        if language is None or static_is_skipped(path) or static_is_test(path):
            continue
        text = head_text(repo, path)
        if text is None:
            not_checked.append(f"{path}: nie da się odczytać z HEAD")
            continue
        sources.append(StaticSource(path, language, lines, text))
    return sources, not_checked


def changed_lines(repo: Path, base: str) -> dict[str, frozenset[int]]:
    """Return the lines the PR adds, per file, against the merge-base."""
    merge_base = static_merge_base(repo, base)
    patch = static_git(repo, *STATIC_GIT_DIFF_ARGS, merge_base, "HEAD")
    return parse_added_lines(patch)


def magic_static_hits(hits: list[MagicHit], rule: str) -> list[StaticHit]:
    """Turn magic-number hits into static hits."""
    return [
        StaticHit(
            hit.line,
            StaticCategory.MAGIC_NUMBER,
            f"{STATIC_MAGIC_LABELS[hit.rule]} {', '.join(hit.values)}",
            rule,
        )
        for hit in hits
    ]


def magic_label_parts(label: str) -> tuple[str, list[str]]:
    """Split a magic-number label into its prefix and its values."""
    for prefix in STATIC_MAGIC_LABELS.values():
        if label.startswith(prefix):
            rest = label[len(prefix) :].strip()
            values = rest.split(STATIC_MAGIC_VALUE_JOINER) if rest else []
            return prefix, values
    return label, []


def magic_label(prefix: str, values: list[str]) -> str:
    """Build a magic-number label from its prefix and values."""
    return " ".join(
        filter(None, [prefix, STATIC_MAGIC_VALUE_JOINER.join(values)])
    )


def merge_magic_hits(hits: list[StaticHit]) -> list[StaticHit]:
    """Join the magic-number hits of one line into a single hit."""
    first: dict[int, StaticHit] = {}
    parts: dict[int, dict[str, list[str]]] = {}
    others: list[StaticHit] = []
    for hit in hits:
        if hit.category is not StaticCategory.MAGIC_NUMBER:
            others.append(hit)
            continue
        first.setdefault(hit.line, hit)
        prefix, values = magic_label_parts(hit.label)
        known = parts.setdefault(hit.line, {}).setdefault(prefix, [])
        known.extend(v for v in values if v not in known)
    merged = [
        dataclasses.replace(
            first[line],
            label=STATIC_MAGIC_JOINER.join(
                magic_label(prefix, values)
                for prefix, values in by_prefix.items()
            ),
        )
        for line, by_prefix in parts.items()
    ]
    return others + merged


def literal_attr_hits(tree: ast.Module) -> list[StaticHit]:
    """Find getattr-family calls whose attribute name is a literal."""
    hits: list[StaticHit] = []
    for node in ast.walk(tree):
        if (
            not isinstance(node, ast.Call)
            or len(node.args) < STATIC_ATTR_MIN_ARGS
        ):
            continue
        func, name = node.func, node.args[1]
        if (
            not isinstance(func, ast.Name)
            or func.id not in STATIC_ATTR_FUNCTIONS
        ):
            continue
        if isinstance(name, ast.Constant) and isinstance(name.value, str):
            label = f"{func.id} na znanym polu"
            hits.append(
                StaticHit(
                    name.lineno,
                    StaticCategory.LITERAL_ATTR,
                    label,
                    STATIC_RULE_PY_ATTR,
                )
            )
    return hits


def python_comment_hits(source: StaticSource) -> list[StaticHit]:
    """Find comments holding a commented-out dict entry."""
    hits: list[StaticHit] = []
    readline = io.StringIO(source.text).readline
    try:
        for token in tokenize.generate_tokens(readline):
            text = token.string.lstrip("#").strip()
            if token.type == tokenize.COMMENT and STATIC_PY_ENTRY.fullmatch(
                text
            ):
                hits.append(
                    StaticHit(
                        token.start[0],
                        StaticCategory.COMMENTED_CODE,
                        "zakomentowany kod",
                        STATIC_RULE_PY_COMMENT,
                    )
                )
    except (tokenize.TokenError, SyntaxError):
        return hits
    return hits


def python_source_hits(
    source: StaticSource, tree: ast.Module
) -> list[StaticHit]:
    """Return the AST hits of a parsed Python file."""
    hits = literal_attr_hits(tree) + python_comment_hits(source)
    hits += magic_static_hits(
        python_magic_hits(tree, source.added, source.text),
        STATIC_RULE_PY_MAGIC,
    )
    return hits


def comment_lines(token: Token) -> Iterator[tuple[int, str]]:
    """Yield the (line, text) pairs a comment token spans."""
    if token.text.startswith("///"):
        return
    if token.text.startswith("//"):
        yield token.line, token.text[2:].lstrip("/!").strip()
        return
    inner = token.text[2:-2] if token.text.endswith("*/") else token.text[2:]
    for offset, raw in enumerate(inner.split("\n")):
        yield token.line + offset, raw.strip().lstrip("*").strip()


def looks_like_code(text: str) -> bool:
    """Tell whether comment text reads like commented-out code."""
    if not text or text.lower().startswith(STATIC_COMMENT_DIRECTIVES):
        return False
    if text.endswith(STATIC_CODE_END):
        return True
    if text.startswith("<"):
        return STATIC_JSX_LIKE.fullmatch(text) is not None
    return any(pattern.match(text) for pattern in STATIC_CODE_LIKE)


def commented_code_hits(
    tokens: list[Token], added: frozenset[int]
) -> list[StaticHit]:
    """Find comments on added lines that look like code."""
    return [
        StaticHit(
            line,
            StaticCategory.COMMENTED_CODE,
            "zakomentowany kod",
            STATIC_RULE_LEXER_COMMENT,
        )
        for token in tokens
        if token.kind is TokenKind.COMMENT
        for line, text in comment_lines(token)
        if line in added and looks_like_code(text)
    ]


def catch_body_start(code: list[Token], index: int) -> int | None:
    """Return the index of the brace opening a catch body."""
    cursor = index + 1
    if cursor < len(code) and code[cursor].text == "(":
        depth = 0
        while cursor < len(code):
            depth += {"(": 1, ")": -1}.get(code[cursor].text, 0)
            cursor += 1
            if depth == 0:
                break
    if cursor < len(code) and code[cursor].text == "{":
        return cursor
    return None


def empty_catch_hits(
    code: list[Token], added: frozenset[int]
) -> list[StaticHit]:
    """Find catch blocks with an empty body on added lines."""
    hits: list[StaticHit] = []
    for index, token in enumerate(code):
        if token.kind is not TokenKind.IDENT or token.text != "catch":
            continue
        open_index = catch_body_start(code, index)
        if open_index is None or open_index + 1 >= len(code):
            continue
        closing = code[open_index + 1]
        if closing.text != "}":
            continue
        line = next(
            (n for n in range(token.line, closing.line + 1) if n in added),
            None,
        )
        if line is not None:
            hits.append(
                StaticHit(
                    line,
                    StaticCategory.EMPTY_CATCH,
                    "pusty catch — błąd zostaje połknięty",
                    STATIC_RULE_LEXER_CATCH,
                )
            )
    return hits


def native_source_hits(source: StaticSource) -> list[StaticHit]:
    """Return the tokenizer hits of a C-family or script file."""
    tokens = tokenize_source(source.text, source.language)
    code = [token for token in tokens if token.kind is not TokenKind.COMMENT]
    hits = commented_code_hits(tokens, source.added)
    hits += empty_catch_hits(code, source.added)
    hits += magic_static_hits(
        token_magic_hits(tokens, source.language, source.added),
        STATIC_RULE_LEXER_MAGIC,
    )
    return hits


def ruff_run(
    executable: str, repo: Path, source: StaticSource
) -> list[dict[str, Any]]:
    """Run the curated ruff rules over one file's HEAD text."""
    argv = [
        executable,
        *STATIC_RUFF_OPTIONS,
        "--select",
        ",".join(STATIC_RUFF_LABELS),
        "--stdin-filename",
        source.path,
        "-",
    ]
    done = subprocess.run(
        argv,
        cwd=repo,
        input=source.text,
        capture_output=True,
        text=True,
        check=False,
        timeout=STATIC_RUFF_TIMEOUT_S,
    )
    if done.returncode not in STATIC_RUFF_OK_EXITS:
        raise StaticUsageError(done.stderr.strip()[:200])
    records: list[dict[str, Any]] = json.loads(done.stdout)
    return records


def ruff_hits(
    repo: Path, sources: list[StaticSource]
) -> tuple[dict[str, list[StaticHit]], str | None]:
    """Run the curated ruff rules, returning hits and a skip reason."""
    executable = shutil.which(STATIC_RUFF)
    if executable is None:
        return {}, "ruff: brak w PATH"
    records: list[dict[str, Any]] = []
    try:
        for source in sources:
            records += ruff_run(executable, repo, source)
    except StaticUsageError as err:
        return {}, f"ruff: błąd uruchomienia ({err})"
    except subprocess.TimeoutExpired:
        return {}, "ruff: przekroczono limit czasu"
    except (OSError, json.JSONDecodeError):
        return {}, "ruff: nieczytelny wynik"
    explained = {
        source.path: python_explained_lines(source.text) for source in sources
    }
    return ruff_records(repo, records, explained), None


def relative_path(repo: Path, name: str) -> str | None:
    """Return a path relative to the repo root, None when outside."""
    path = Path(name)
    if not path.is_absolute():
        path = repo / path
    try:
        return path.resolve().relative_to(repo.resolve()).as_posix()
    except ValueError:
        return None


def ruff_records(
    repo: Path,
    records: list[dict[str, Any]],
    explained: dict[str, frozenset[int]],
) -> dict[str, list[StaticHit]]:
    """Convert ruff JSON records into hits per path."""
    hits: dict[str, list[StaticHit]] = {}
    for record in records:
        rule = record.get("code")
        path = relative_path(repo, record.get("filename", ""))
        if rule not in STATIC_RUFF_LABELS or path is None:
            continue
        line = record["location"]["row"]
        if rule == STATIC_RULE_RUFF_MAGIC and line in explained.get(path, ()):
            continue
        category, label = STATIC_RUFF_LABELS[rule]
        if rule == STATIC_RULE_RUFF_MAGIC:
            value = STATIC_RUFF_VALUE.search(record.get("message", ""))
            label = f"{label} {value.group(1)}" if value else label
        hits.setdefault(path, []).append(
            StaticHit(line, category, label, rule)
        )
    return hits


def clone_side(repo: Path, raw: dict[str, Any]) -> CloneSide | None:
    """Convert a jscpd file entry into a clone side."""
    path = relative_path(repo, raw["name"])
    if path is None:
        return None
    return CloneSide(path, int(raw["start"]), int(raw["end"]))


def clone_hits(
    repo: Path,
    duplicates: list[dict[str, Any]],
    added: dict[str, frozenset[int]],
) -> dict[str, list[StaticHit]]:
    """Report each clone fragment that overlaps added lines."""
    hits: dict[str, list[StaticHit]] = {}
    for item in duplicates:
        first = clone_side(repo, item["firstFile"])
        second = clone_side(repo, item["secondFile"])
        if first is None or second is None:
            continue
        for mine, other in ((first, second), (second, first)):
            overlap = sorted(
                set(range(mine.start, mine.end + 1))
                & added.get(mine.path, frozenset())
            )
            if overlap:
                label = f"zduplikowany kod — jak w {other.path}:{other.start}"
                hits.setdefault(mine.path, []).append(
                    StaticHit(
                        overlap[0],
                        StaticCategory.DUPLICATION,
                        label,
                        STATIC_RULE_JSCPD,
                    )
                )
    return hits


def tracked_clone_files(repo: Path) -> list[str]:
    """List the tracked files jscpd should compare."""
    listing = static_git(repo, "ls-files", "-z").split("\0")
    return [
        name
        for name in listing
        if PurePosixPath(name).suffix in STATIC_CLONE_SUFFIXES
        and not static_is_skipped(name)
        and not static_is_test(name)
    ]


def jscpd_hits(
    repo: Path, added: dict[str, frozenset[int]]
) -> tuple[dict[str, list[StaticHit]], str | None]:
    """Run jscpd over tracked files, returning hits and a skip reason."""
    executable = shutil.which(STATIC_JSCPD)
    if executable is None:
        return {}, "jscpd: brak w PATH"
    files = tracked_clone_files(repo)
    if sum(len(name) + 1 for name in files) > STATIC_ARGUMENT_LIMIT:
        return {}, "jscpd: zbyt wiele plików"
    with tempfile.TemporaryDirectory() as scratch:
        argv = [executable, *STATIC_JSCPD_OPTIONS, "--output", scratch, *files]
        try:
            subprocess.run(
                argv,
                cwd=repo,
                capture_output=True,
                check=False,
                timeout=STATIC_JSCPD_TIMEOUT_S,
            )
            report = json.loads(
                (Path(scratch) / STATIC_JSCPD_REPORT).read_text(
                    encoding=STATIC_ENCODING
                )
            )
            return clone_hits(repo, report["duplicates"], added), None
        except subprocess.TimeoutExpired:
            return {}, "jscpd: przekroczono limit czasu"
        except (OSError, json.JSONDecodeError, KeyError, TypeError):
            return {}, "jscpd: nieczytelny wynik"


def merge_hits(
    target: dict[str, list[StaticHit]], extra: dict[str, list[StaticHit]]
) -> None:
    """Add the hits of extra to target."""
    for path, hits in extra.items():
        target.setdefault(path, []).extend(hits)


def unique_hits(hits: list[StaticHit]) -> list[StaticHit]:
    """Drop hits repeating a rule on the same line."""
    seen: set[tuple[int, str]] = set()
    unique: list[StaticHit] = []
    for hit in hits:
        key = (hit.line, hit.rule)
        if key not in seen:
            seen.add(key)
            unique.append(hit)
    return unique


def build_findings(
    sources: dict[str, StaticSource], hits: dict[str, list[StaticHit]]
) -> list[StaticFinding]:
    """Turn hits on added lines into findings with snippets."""
    findings: list[StaticFinding] = []
    for path in sorted(hits):
        source = sources.get(path)
        if source is None:
            continue
        lines = source.text.split("\n")
        kept = [h for h in hits[path] if h.line in source.added]
        for hit in sorted(
            unique_hits(merge_magic_hits(kept)),
            key=lambda item: (item.line, item.category),
        ):
            snippet = lines[hit.line - 1].strip()[:STATIC_SNIPPET_LIMIT]
            findings.append(
                StaticFinding(
                    path, hit.line, hit.category, hit.label, hit.rule, snippet
                )
            )
    return findings


def static_report(repo: Path, base: str) -> StaticReport:
    """List the mechanical review candidates on the lines a PR adds."""
    added = changed_lines(repo, base)
    sources, not_checked = load_sources(repo, added)
    hits: dict[str, list[StaticHit]] = {}
    parsed: list[StaticSource] = []
    for source in sources:
        if source.language is StaticLanguage.PYTHON:
            tree = parse_python(source.text)
            if tree is None:
                not_checked.append(f"{source.path}: błąd składni, pominięto")
                continue
            parsed.append(source)
            hits[source.path] = python_source_hits(source, tree)
        else:
            hits[source.path] = native_source_hits(source)
    if parsed:
        found, reason = ruff_hits(repo, parsed)
        merge_hits(hits, found)
        not_checked += [reason] if reason else []
    if any(
        PurePosixPath(s.path).suffix in STATIC_CLONE_SUFFIXES for s in sources
    ):
        found, reason = jscpd_hits(repo, added)
        merge_hits(hits, found)
        not_checked += [reason] if reason else []
    by_path = {source.path: source for source in sources}
    return StaticReport(build_findings(by_path, hits), not_checked)


def static_parser() -> argparse.ArgumentParser:
    """Build the parser of the static subcommand."""
    parser = argparse.ArgumentParser(prog="bb-sweep static")
    parser.add_argument("--repo", default=".")
    parser.add_argument("--base", required=True)
    parser.add_argument("--json", action="store_true")
    return parser


def render_static(report: StaticReport, *, as_json: bool) -> None:
    """Print the static report as JSON or one text line per finding."""
    if as_json:
        document = {
            "findings": [dataclasses.asdict(f) for f in report.findings],
            "not_checked": report.not_checked,
        }
        print(json.dumps(document, ensure_ascii=False, indent=1))
        return
    for finding in report.findings:
        print(
            f"{finding.path}:{finding.line} {finding.category}"
            f" — {finding.label}"
        )
    for entry in report.not_checked:
        print(f"nie sprawdzono: {entry}")


def cmd_static(argv: list[str]) -> int:
    """List mechanical review candidates on the lines a PR adds."""
    args = static_parser().parse_args(argv)
    try:
        report = static_report(Path(args.repo), args.base)
    except StaticUsageError as err:
        print(f"bb-sweep static: {err}", file=sys.stderr)
        return STATIC_USAGE_EXIT
    render_static(report, as_json=args.json)
    return STATIC_OK_EXIT


SUBCOMMANDS = {
    "resolve": cmd_resolve,
    "harvest": cmd_harvest,
    "harvest-mark": cmd_harvest_mark,
    "harvest-done": cmd_harvest_done,
    "static": cmd_static,
}
OFFLINE_SUBCOMMANDS = frozenset({"static"})


def main(argv: list[str]) -> int:
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0
    if argv and argv[0] in OFFLINE_SUBCOMMANDS:
        return SUBCOMMANDS[argv[0]](argv[1:])
    if not os.path.exists(CRED_PATH):
        print(f"brak poświadczeń: {CRED_PATH}", file=sys.stderr)
        return 2
    handler = SUBCOMMANDS.get(argv[0]) if argv else None
    if handler is not None:
        return handler(argv[1:])
    as_json = "--json" in argv
    refresh = "--refresh-repos" in argv
    only = None
    for i, a in enumerate(argv):
        if a == "--repos" and i + 1 < len(argv):
            only = [s for s in argv[i + 1].split(",") if s]
    known = {"mine", "review", "replies", "approve"}
    sections = {a for a in argv if a in known} or set(known)
    if "all" in argv:
        sections = set(known)

    if not os.path.exists(CRED_PATH):
        print(f"brak poświadczeń: {CRED_PATH}", file=sys.stderr)
        return 2

    user = me()
    sections_needing_repos = sections & {"review", "replies", "approve"}
    RESOLVED_IDS.update(load_cache(RESOLVED_CACHE, []))
    if only:
        repos = only
    elif sections_needing_repos:
        repos = candidate_repos(repo_index(refresh), "--deep" in argv)
    else:
        repos = []
    result = collect(
        repos,
        user["uuid"],
        include_drafts="--include-drafts" in argv,
        need_review=bool(sections_needing_repos),
    )
    save_cache(RESOLVED_CACHE, sorted(RESOLVED_IDS))
    if as_json:
        print(json.dumps(result, ensure_ascii=False, indent=1))
    else:
        drafts = " (z draftami)" if "--include-drafts" in argv else ""
        scope = f"{len(repos)} repozytoriów w skanie" if repos else "moje PR-y"
        print(f"bb-sweep — {user['display_name']} — {scope}{drafts}")
        render(result, sections)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
