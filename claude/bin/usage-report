#!/usr/bin/env python3
"""Token/context baseline from the local Claude Code transcripts."""
import argparse
import collections
import glob
import json
import os
import re
import shlex
import time
from dataclasses import dataclass, field
from pathlib import PurePath

PROJECTS_DIR = os.path.expanduser("~/.claude/projects")
SUBAGENT_MARKER = "/subagents/"
MEMORY_MARKER = "/memory/"
CHARS_PER_TOKEN = 4
SECONDS_PER_DAY = 86400

WEIGHT_INPUT = 1.0
WEIGHT_CACHE_CREATION = 1.25
WEIGHT_CACHE_READ = 0.1
WEIGHT_OUTPUT = 5.0

BIG_CONTEXT_TOKENS = 200_000
BIG_READ_CHARS = 3_000 * CHARS_PER_TOKEN
TOP_TOOLS = 8
CODEX_TOOL = "mcp__codex-worker__codex_review_changes"
RECORD_KEY_PREFIX = "record-"
VERIFY_NAME = "verify"
OPTIONS_END = "--"
SHELLS = frozenset({"sh", "bash", "zsh", "dash", "ksh"})
MAX_SHELL_DEPTH = 3
KEYWORDS = frozenset(
    {"if", "then", "elif", "else", "while", "until", "do", "!", "time", "{"}
)
NO_OPTION_VALUES: frozenset[str] = frozenset()
WRAPPER_VALUE_OPTIONS = {
    "env": frozenset({"-u", "-C", "--unset", "--chdir"}),
    "command": NO_OPTION_VALUES,
    "exec": NO_OPTION_VALUES,
    "nohup": NO_OPTION_VALUES,
    "sudo": frozenset({"-u", "-g", "--user", "--group"}),
    "nice": frozenset({"-n", "--adjustment"}),
    "timeout": frozenset({"-s", "-k", "--signal", "--kill-after"}),
}
VERIFY_VALUE_OPTIONS = frozenset({"-t", "--tail", "-n", "--name", "--repo"})
DURATION_WRAPPER = "timeout"
LOOKUP_WRAPPER = "command"
LOOKUP_OPTIONS = frozenset({"-v", "-V"})
OPTION_PREFIX = "-"
LONG_OPTION_PREFIX = "--"
COMMENT_PREFIX = "#"
NEWLINE = "\n"
BACKSLASH = "\\"
QUOTES = "'\""
SEPARATOR_CHARS = ";&|()" + NEWLINE
INLINE_WHITESPACE = " \t\r"
WORD_BREAKS = INLINE_WHITESPACE + SEPARATOR_CHARS
ENV_ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=")
DURATION = re.compile(r"\d")
HEREDOC = re.compile(
    r"""(?P<skip>'[^']*'|"(?:\\.|[^"\\])*")"""
    r"""|(?<!<)<<(?P<dash>-?)\s*(?:'(?P<single>[^'\n]+)'"""
    r"""|"(?P<double>[^"\n]+)"|\\?(?P<bare>[A-Za-z_][\w-]*))"""
)

RUNNER_BODY = (
    r"(?:pytest|vitest|npm (?:run )?(?:test|lint|build|e2e)"
    r"|make (?:test|lint|build|check|benchmark)"
    r"|ruff|eslint|tsc\b|playwright|cargo (?:test|build|clippy)|go test"
    r"|alembic|pio (?:run|test)|ctest|cmake --build|docker (?:compose )?build)"
)
RUNNER_PREFIX = r"(?:(?:uv run|poetry run|npx|pnpm exec|python3?\s+-m)\s+)?"
EXECUTED_RUNNER = re.compile(RUNNER_PREFIX + RUNNER_BODY)
WRAPPED_RUNNER = re.compile(r"\b" + RUNNER_BODY)


@dataclass
class Usage:
    turns: int = 0
    input: int = 0
    creation: int = 0
    read: int = 0
    output: int = 0

    def add(self, usage: dict) -> None:
        self.turns += 1
        self.input += usage.get("input_tokens") or 0
        self.creation += usage.get("cache_creation_input_tokens") or 0
        self.read += usage.get("cache_read_input_tokens") or 0
        self.output += usage.get("output_tokens") or 0

    @property
    def input_equivalent(self) -> float:
        return (
            self.input * WEIGHT_INPUT
            + self.creation * WEIGHT_CACHE_CREATION
            + self.read * WEIGHT_CACHE_READ
            + self.output * WEIGHT_OUTPUT
        )


@dataclass
class MessageUsage:
    is_sub: bool
    usage: dict


@dataclass
class Stats:
    messages: dict = field(default_factory=dict)
    main: Usage = field(default_factory=Usage)
    sub: Usage = field(default_factory=Usage)
    contexts: list = field(default_factory=list)
    result_tokens: collections.Counter = field(default_factory=collections.Counter)
    result_calls: collections.Counter = field(default_factory=collections.Counter)
    result_max: collections.Counter = field(default_factory=collections.Counter)
    agents: collections.Counter = field(default_factory=collections.Counter)
    tests_verify: int = 0
    tests_raw: int = 0
    codex_calls: int = 0
    reads: int = 0
    reads_unbounded: int = 0
    reads_unbounded_big: int = 0
    reads_unbounded_big_tokens: float = 0.0
    files: int = 0
    bytes: int = 0


def select_files(days: int, project: str) -> list:
    paths = [
        p
        for p in glob.glob(os.path.join(PROJECTS_DIR, "**", "*.jsonl"), recursive=True)
        if MEMORY_MARKER not in p
    ]
    if days:
        cutoff = time.time() - days * SECONDS_PER_DAY
        paths = [p for p in paths if os.path.getmtime(p) >= cutoff]
    if project:
        slug = re.sub(r"[^A-Za-z0-9]+", "-", os.path.abspath(os.path.expanduser(project)))
        paths = [p for p in paths if slug in p or project in p]
    return sorted(paths)


def result_text(content) -> str:
    if isinstance(content, list):
        return "".join(c.get("text", "") for c in content if isinstance(c, dict))
    return content if isinstance(content, str) else str(content or "")


def strip_heredoc_bodies(command: str) -> str:
    """Drop heredoc body lines and their delimiter lines from a command."""
    lines = command.split(NEWLINE)
    kept: list[str] = []
    index = 0
    while index < len(lines):
        kept.append(lines[index])
        index += 1
        for terminator in heredoc_terminators(lines[index - 1]):
            end = terminator_index(lines, index, terminator)
            if end is None:
                break
            index = end + 1
    return NEWLINE.join(kept)


def heredoc_terminators(line: str) -> list[re.Pattern[str]]:
    """Build the terminator-line patterns of the heredocs a line opens."""
    return [
        re.compile(
            ("\t*" if match["dash"] else "")
            + re.escape(match["single"] or match["double"] or match["bare"])
        )
        for match in HEREDOC.finditer(line)
        if not match["skip"]
    ]


def terminator_index(
    lines: list[str], start: int, terminator: re.Pattern[str]
) -> int | None:
    """Return the index of the heredoc terminator line, if there is one."""
    for index in range(start, len(lines)):
        if terminator.fullmatch(lines[index]):
            return index
    return None


def strip_comments(command: str) -> str:
    """Remove line continuations and unquoted comments from a command."""
    out: list[str] = []
    quote = ""
    word_start = True
    index = 0
    while index < len(command):
        char = command[index]
        escaped = command[index + 1 : index + 2]
        if char == BACKSLASH and quote != "'":
            if escaped != NEWLINE:
                out.append(char + escaped)
            index += 2
            word_start = False
            continue
        if char == COMMENT_PREFIX and word_start and not quote:
            index = command.find(NEWLINE, index)
            if index < 0:
                break
            continue
        if quote and char == quote:
            quote = ""
        elif not quote and char in QUOTES:
            quote = char
        out.append(char)
        word_start = not quote and char in WORD_BREAKS
        index += 1
    return "".join(out)


def command_segments(command: str) -> list[list[str]]:
    """Split a command into the word lists of its simple commands."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars=SEPARATOR_CHARS)
    lexer.whitespace = INLINE_WHITESPACE
    lexer.whitespace_split = True
    lexer.commenters = ""
    segments: list[list[str]] = [[]]
    try:
        for token in lexer:
            if set(token) <= set(SEPARATOR_CHARS):
                segments.append([])
            else:
                segments[-1].append(token)
    except ValueError:
        return []
    return [words for words in segments if words]


def command_words(words: list[str]) -> list[str]:
    """Strip assignments, keywords and wrappers before the real command."""
    index = 0
    while index < len(words):
        word = words[index]
        index += 1
        if ENV_ASSIGNMENT.match(word) or word in KEYWORDS:
            continue
        wrapper = PurePath(word).name
        if wrapper not in WRAPPER_VALUE_OPTIONS:
            return words[index - 1 :]
        options_start = index
        while index < len(words) and words[index].startswith(OPTION_PREFIX):
            value_option = words[index] in WRAPPER_VALUE_OPTIONS[wrapper]
            index += 2 if value_option else 1
        if wrapper == LOOKUP_WRAPPER and LOOKUP_OPTIONS.intersection(
            words[options_start:index]
        ):
            return []
        has_duration = index < len(words) and DURATION.match(words[index])
        if wrapper == DURATION_WRAPPER and has_duration:
            index += 1
    return []


def shell_command_string(args: list[str]) -> str | None:
    """Return the script string given to a shell by its -c style flag."""
    for position, arg in enumerate(args):
        is_short_flag = arg.startswith(OPTION_PREFIX) and not arg.startswith(
            LONG_OPTION_PREFIX
        )
        if is_short_flag and "c" in arg:
            return args[position + 1] if position + 1 < len(args) else None
    return None


def verify_arguments(args: list[str]) -> list[str]:
    """Return the arguments verify wraps, after its own options."""
    index = 0
    while index < len(args) and args[index].startswith(OPTION_PREFIX):
        if args[index] == OPTIONS_END:
            return args[index + 1 :]
        index += 2 if args[index] in VERIFY_VALUE_OPTIONS else 1
    return args[index:]


def count_runs(command: str, depth: int = 0) -> tuple[int, int]:
    """Count verify-wrapped and raw runner invocations in a command."""
    verify_runs = raw_runs = 0
    cleaned = strip_comments(strip_heredoc_bodies(command))
    for segment in command_segments(cleaned):
        words = command_words(segment)
        if not words:
            continue
        name = PurePath(words[0]).name
        rest = words[1:]
        script = shell_command_string(rest) if name in SHELLS else None
        if script is not None and depth < MAX_SHELL_DEPTH:
            inner_verify, inner_raw = count_runs(script, depth + 1)
            verify_runs += inner_verify
            raw_runs += inner_raw
        elif name == VERIFY_NAME:
            wrapped = " ".join(verify_arguments(rest))
            verify_runs += bool(WRAPPED_RUNNER.search(wrapped))
        else:
            raw_runs += bool(EXECUTED_RUNNER.match(" ".join([name, *rest])))
    return verify_runs, raw_runs


def scan(path: str, stats: Stats) -> None:
    is_sub = SUBAGENT_MARKER in path
    tool_names = {}
    unbounded_reads = set()
    with open(path, errors="replace") as handle:
        for number, line in enumerate(handle):
            if '"usage"' not in line and '"tool_result"' not in line and '"tool_use"' not in line:
                continue
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            message = entry.get("message") or {}
            kind = entry.get("type")
            if kind == "assistant":
                usage = message.get("usage") or {}
                if usage:
                    key = message.get("id") or f"{RECORD_KEY_PREFIX}{path}#{number}"
                    known = stats.messages.get(key)
                    if known is None:
                        stats.messages[key] = MessageUsage(is_sub, usage)
                    else:
                        known.usage = usage
                for block in message.get("content") or []:
                    if not isinstance(block, dict) or block.get("type") != "tool_use":
                        continue
                    name = block.get("name") or "?"
                    params = block.get("input") or {}
                    tool_names[block.get("id")] = name
                    if name in ("Agent", "Task"):
                        stats.agents[str(params.get("subagent_type") or "?")] += 1
                    elif name == CODEX_TOOL:
                        stats.codex_calls += 1
                    elif name == "Read":
                        stats.reads += 1
                        if "limit" not in params and "offset" not in params:
                            stats.reads_unbounded += 1
                            unbounded_reads.add(block.get("id"))
                    elif name == "Bash":
                        command = str(params.get("command") or "")
                        verify_runs, raw_runs = count_runs(command)
                        stats.tests_verify += verify_runs
                        stats.tests_raw += raw_runs
            elif kind == "user" and isinstance(message.get("content"), list):
                for block in message["content"]:
                    if not isinstance(block, dict) or block.get("type") != "tool_result":
                        continue
                    name = tool_names.get(block.get("tool_use_id"), "?")
                    size = len(result_text(block.get("content")))
                    stats.result_tokens[name] += size / CHARS_PER_TOKEN
                    stats.result_calls[name] += 1
                    stats.result_max[name] = max(stats.result_max[name], size / CHARS_PER_TOKEN)
                    if block.get("tool_use_id") in unbounded_reads and size > BIG_READ_CHARS:
                        stats.reads_unbounded_big += 1
                        stats.reads_unbounded_big_tokens += size / CHARS_PER_TOKEN

def aggregate(stats: Stats) -> None:
    for message in stats.messages.values():
        (stats.sub if message.is_sub else stats.main).add(message.usage)
        context = (
            (message.usage.get("input_tokens") or 0)
            + (message.usage.get("cache_read_input_tokens") or 0)
            + (message.usage.get("cache_creation_input_tokens") or 0)
        )
        if context and not message.is_sub:
            stats.contexts.append(context)


def human(value: float) -> str:
    if value >= 1e9:
        return f"{value / 1e9:.1f}G"
    if value >= 1e6:
        return f"{value / 1e6:.1f}M"
    if value >= 1e3:
        return f"{value / 1e3:.0f}k"
    return f"{value:.0f}"


def percentile(values: list, fraction: float) -> int:
    if not values:
        return 0
    index = min(len(values) - 1, int(len(values) * fraction))
    return values[index]


def report(stats: Stats, days: int, project: str) -> None:
    window = f"{days} days" if days else "all time"
    print(
        f"usage-report — {stats.files} transcripts, {stats.bytes / 1e6:.0f} MB, "
        f"window {window}, project {project or 'all'}"
    )
    total_equivalent = stats.main.input_equivalent + stats.sub.input_equivalent or 1.0
    print(f"{'':9s}{'turns':>7s}{'input':>9s}{'create':>9s}{'read':>9s}{'output':>9s}{'input-eq':>10s}{'share':>7s}")
    for label, usage in (("main", stats.main), ("subagent", stats.sub)):
        print(
            f"{label:9s}{usage.turns:7d}{human(usage.input):>9s}{human(usage.creation):>9s}"
            f"{human(usage.read):>9s}{human(usage.output):>9s}{human(usage.input_equivalent):>10s}"
            f"{usage.input_equivalent / total_equivalent * 100:6.0f}%"
        )
    contexts = sorted(stats.contexts)
    big = sum(1 for c in contexts if c > BIG_CONTEXT_TOKENS)
    share = big / len(contexts) * 100 if contexts else 0
    print(
        f"context per main turn: median {human(percentile(contexts, 0.5))} "
        f"p90 {human(percentile(contexts, 0.9))} max {human(contexts[-1] if contexts else 0)} "
        f"| turns > {BIG_CONTEXT_TOKENS // 1000}k: {big} ({share:.0f}%)"
    )
    print(f"tool-result tokens by tool (top {TOP_TOOLS}):")
    for name, tokens in stats.result_tokens.most_common(TOP_TOOLS):
        calls = stats.result_calls[name] or 1
        print(
            f"  {name[:28]:28s}{human(tokens):>8s}  calls {calls:5d}  "
            f"avg {human(tokens / calls):>6s}  max {human(stats.result_max[name]):>6s}"
        )
    runs = stats.tests_verify + stats.tests_raw
    raw_share = stats.tests_raw / runs * 100 if runs else 0
    print(f"test/lint/build runs: via verify {stats.tests_verify}, raw {stats.tests_raw} ({raw_share:.0f}% raw)")
    print(
        f"Read calls: {stats.reads} total, {stats.reads_unbounded} without limit/offset, "
        f"{stats.reads_unbounded_big} results > {BIG_READ_CHARS // CHARS_PER_TOKEN // 1000}k tok "
        f"(~{human(stats.reads_unbounded_big_tokens)} tok)"
    )
    spawns = ", ".join(f"{name} {count}" for name, count in stats.agents.most_common()) or "none"
    print(f"Agent spawns: {spawns}")
    print(f"codex review calls: {stats.codex_calls}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--days", type=int, default=0, help="only transcripts modified in the last N days")
    parser.add_argument("--project", default="", help="only the projects/ subdir matching this path")
    args = parser.parse_args()

    stats = Stats()
    for path in select_files(args.days, args.project):
        stats.files += 1
        stats.bytes += os.path.getsize(path)
        scan(path, stats)
    aggregate(stats)
    report(stats, args.days, args.project)


if __name__ == "__main__":
    main()
