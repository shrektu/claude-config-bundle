{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {},
  "permissions": {
    "allow": [
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Agent(codex-runner)",
      "Agent(implementer)",
      "Agent(reviewer-opus)",
      "Agent(flash-review-runner)",
      "Agent(writer)",
      "Agent(ui-writer)",
      "Agent(plan-gate-runner)",
      "mcp__codex-worker__*",
      "mcp__agy-worker__*",
      "Bash(python3 __HOME__/.claude/hooks/*)",
      "Edit(/__HOME__/.claude/hooks/**)"
    ],
    "deny": [
      "Bash(codex *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/git-guard.py",
            "timeout": 10,
            "statusMessage": "git-guard"
          },
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/verify-guard.py",
            "timeout": 10,
            "statusMessage": "verify-guard"
          },
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/git-policy.py",
            "timeout": 10,
            "statusMessage": "git-policy"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/comment-guard.py",
            "timeout": 10,
            "statusMessage": "comment-guard"
          },
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/tdd-guard.py",
            "timeout": 10,
            "statusMessage": "tdd-guard"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/read-guard.py",
            "timeout": 10,
            "statusMessage": "read-guard"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/delegation-guard.py",
            "timeout": 10,
            "statusMessage": "delegation-guard"
          }
        ]
      },
      {
        "matcher": "mcp__codex-worker__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/codex-gate.py",
            "timeout": 10,
            "statusMessage": "codex-gate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'payload=$(cat); case \"$payload\" in *commit*) printf \"%s\" \"$payload\" | python3 __HOME__/.claude/hooks/standards-gate.py;; esac'",
            "timeout": 1200,
            "statusMessage": "standards-gate"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/bin/repo-facts",
            "timeout": 10,
            "statusMessage": "repo-facts"
          },
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/mode-notice.py",
            "timeout": 5,
            "statusMessage": "mode-notice"
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/session-start-marker.py",
            "timeout": 10,
            "statusMessage": "session-start-marker"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/bin/habits list --repo \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 10,
            "statusMessage": "habits"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/subagent-verify-check.py",
            "timeout": 10,
            "statusMessage": "subagent-verify-check"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/standards-gate.py",
            "timeout": 480,
            "statusMessage": "standards-gate"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/context-guard.py",
            "timeout": 10,
            "statusMessage": "context-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/autofix-on-edit.py",
            "timeout": 40,
            "statusMessage": "autofix"
          }
        ]
      },
      {
        "matcher": "Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/context-guard.py",
            "timeout": 10,
            "statusMessage": "context-guard"
          }
        ]
      }
    ]
  },
  "bashOutputMaxChars": 6000,
  "taskOutputMaxChars": 8000,
  "statusLine": {
    "type": "command",
    "command": "bash __HOME__/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "whatsapp-claude-plugin": {
      "source": {
        "source": "github",
        "repo": "Rich627/whatsapp-claude-plugin"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "normal",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
